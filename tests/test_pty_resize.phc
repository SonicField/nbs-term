/*
 * test_pty_resize.phc — J-resize TIOCSWINSZ regression anchor
 *
 * Per supervisor 2026-05-13 09:47:45 + alexie 09:46:53 automated-suite
 * directive. Discriminator for J-resize (pty.phc:255-261 POSIX path):
 * if alexie reports 'remote pty doesn't see resize', AND this passes,
 * the bug is in (a) the Tk Configure binding that calls pty_resize, or
 * (b) the local PTY -> ssh-client SIGWINCH propagation; if this fails,
 * regression is inside pty_resize's ioctl call OR the OS-level winsize
 * round-trip pty_resize relies on.
 *
 * Approach — SPEC COPY of pty_resize body (pty.phc:255-261) on a real
 * PTY master fd opened via openpty(). Verifies that TIOCSWINSZ +
 * TIOCGWINSZ round-trip preserves rows/cols, which is the OS contract
 * pty_resize wraps.
 *
 * Win32 path uses ResizePseudoConsole (pty.phc:458-462) which requires
 * a fully-spawned ConPTY child process — too heavy for unit-test scope.
 * Win path is SKIPPED with exit 0 (printed banner so CI surfaces it).
 *
 * Headless POSIX (libc + libutil for openpty); no Tk/PTY-spawn/ssh.
 */

#include <stdio.h>
#include <string.h>

#if defined(_WIN32)

int main(void) {
    /* Win32 ResizePseudoConsole requires CreatePseudoConsole + spawned
     * child — out of scope for unit-test J-resize round-trip. SKIP. */
    printf("test_pty_resize: SKIP (Win32 ResizePseudoConsole needs ConPTY harness)\n");
    return 0;
}

#else  /* POSIX */

#include <sys/ioctl.h>
#include <unistd.h>

#if defined(__linux__)
#  include <pty.h>
#elif defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__)
#  include <util.h>
#else
/* Generic fallback — most modern POSIX systems either have pty.h or util.h.
 * If neither, the linker will complain about openpty. */
extern int openpty(int *, int *, char *, void *, void *);
#endif

/* SPEC COPY — pty_resize POSIX body from src/pty.phc:255-261. Production
 * takes a PTYHandle*; spec takes a raw fd to skip PTYHandle construction. */
static void pty_resize_spec(int master_fd, int rows, int cols) {
    if (master_fd < 0) return;
    struct winsize ws = {0};
    ws.ws_row = (unsigned short)rows;
    ws.ws_col = (unsigned short)cols;
    ioctl(master_fd, TIOCSWINSZ, &ws);
}

static int check_round_trip(int master, int rows, int cols, const char *label) {
    pty_resize_spec(master, rows, cols);
    struct winsize got = {0};
    if (ioctl(master, TIOCGWINSZ, &got) != 0) {
        printf("FAIL %s: TIOCGWINSZ ioctl failed\n", label);
        return 1;
    }
    if (got.ws_row != (unsigned short)rows || got.ws_col != (unsigned short)cols) {
        printf("FAIL %s: round-trip got rows=%u cols=%u, want rows=%d cols=%d\n",
               label, (unsigned)got.ws_row, (unsigned)got.ws_col, rows, cols);
        return 1;
    }
    return 0;
}

int main(void) {
    int master = -1, slave = -1;
    if (openpty(&master, &slave, NULL, NULL, NULL) != 0) {
        printf("test_pty_resize: SKIP (openpty failed — no pty available in this env)\n");
        return 0;
    }

    int fail = 0;

    /* (1) Standard 80x24 */
    fail += check_round_trip(master, 24, 80, "80x24");

    /* (2) Larger 200x60 */
    fail += check_round_trip(master, 60, 200, "200x60");

    /* (3) Tiny 1x1 (degenerate but legal) */
    fail += check_round_trip(master, 1, 1, "1x1");

    /* (4) Wider window 24x132 */
    fail += check_round_trip(master, 24, 132, "132x24");

    /* (5) Tall window 100x40 */
    fail += check_round_trip(master, 100, 40, "40x100");

    /* (6) Resize updates: 80x24 -> 132x40 -> 80x24 */
    fail += check_round_trip(master, 24, 80,  "resize cycle 80x24 (a)");
    fail += check_round_trip(master, 40, 132, "resize cycle 132x40 (b)");
    fail += check_round_trip(master, 24, 80,  "resize cycle 80x24 (c)");

    /* (7) Max ushort boundary (USHRT_MAX = 65535) — winsize fields are
     * unsigned short; verifies no overflow at the API edge. */
    fail += check_round_trip(master, 65535, 65535, "max ushort boundary");

    /* (8) negative master_fd guard from production: pty_resize_spec
     * returns silently. Verify by calling on -1 then re-asserting the
     * good fd's last value is unchanged. */
    pty_resize_spec(-1, 9, 9);  /* must be a no-op */
    fail += check_round_trip(master, 24, 80, "after no-op fd=-1, good fd still works");

    close(master);
    close(slave);

    if (fail == 0) {
        printf("test_pty_resize: PASS (9 cases)\n");
        return 0;
    }
    printf("test_pty_resize: FAIL (%d failures)\n", fail);
    return 1;
}

#endif  /* POSIX */
