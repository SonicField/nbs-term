/*
 * test_pty_burst.phc — programmatic byte-accounting test for pty.phc
 *
 * Spawns ourself in --emit producer mode through pty_open, drains via
 * pty_read in a Tcl event loop, asserts the end-of-stream marker
 * arrives AND received byte count is at least the expected payload
 * size. No Tk/render dependency; isolates the PTY layer from rendering
 * for clean byte accounting.
 *
 * Producer choice — direct-exec self-spawn (no shell wrapper):
 *     ConPTY (Win) and forkpty (POSIX) launch this binary's --emit mode
 *     directly. Originally this test wrapped its producer in
 *     powershell -NoProfile (Win) and sh -c awk (POSIX); the Win path
 *     was retired after the (iii) probe (1f2e33a) confirmed
 *     powershell-startup as the bottleneck on Win CI rc=2 — short read
 *     148B / 262144 expected, fault localised to producer choice, not
 *     to pty.phc / ConPTY. Direct-exec eliminates the cold-start tax
 *     uniformly and keeps the test cross-platform under one shape.
 *
 * What this falsifies:
 *   POSIX — read-pump-under-load: validates that the non-blocking
 *           master_fd + Tcl_CreateFileHandler driven loop drains
 *           bursty output without losing bytes mid-stream.
 *   Win32 — ring backpressure (c8d5378 fix #4): producer emits ~256KB
 *           which exceeds PTY_RING_CAP (65536). With the fix,
 *           SleepConditionVariableSRW paces the I/O thread so all
 *           bytes arrive. Without it, the ring would overflow and
 *           bytes would be silently dropped — observed as a short
 *           read (exit 3).
 *
 * Build: make build/test_pty_burst
 * Run:   build/test_pty_burst              (test driver)
 *        build/test_pty_burst --emit       (producer; for the driver to
 *                                           spawn — not user-facing)
 *
 * Exit codes:
 *   0 — pass: marker observed AND received >= BURST_BYTES
 *   1 — usage / setup failure
 *   2 — timeout: marker not seen within deadline
 *   3 — short read: marker observed but received < BURST_BYTES (the
 *       primary backpressure-failure signal on Win32)
 */

#if !defined(_WIN32)
#  ifndef _DEFAULT_SOURCE
#    define _DEFAULT_SOURCE 1
#  endif
#  ifndef _POSIX_C_SOURCE
#    define _POSIX_C_SOURCE 200809L
#  endif
#endif

#include <tcl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#if !defined(_WIN32)
#  include <unistd.h>
#  include <time.h>
#endif

/* phc_assert macros — match the in-source defs in p3_pty.phc so
 * test_pty_burst goes through the same phc include chain identically. */
#define phc_require(expr, msg) do { if (!(expr)) { \
    fprintf(stderr, "REQUIRE FAILED %s:%d: %s\n", __FILE__, __LINE__, msg); \
    abort(); }} while(0)
#define phc_check(expr, msg) do { if (!(expr)) { \
    fprintf(stderr, "CHECK FAILED %s:%d: %s\n", __FILE__, __LINE__, msg); \
    abort(); }} while(0)
#define phc_invariant(expr, msg) do { if (!(expr)) { \
    fprintf(stderr, "INVARIANT FAILED %s:%d: %s\n", __FILE__, __LINE__, msg); \
    abort(); }} while(0)

#include "pty.phc"

/* 256KB exceeds pty.phc PTY_RING_CAP (65536), forcing the Win32 ring
 * to wrap multiple times under producer pressure. Tuned high enough
 * to surface backpressure regressions; low enough to finish in CI. */
#define BURST_BYTES 262144
#define MARKER "PHC_BURST_END"
#define MARKER_LEN 13

static int run_emitter(void) {
    /* Producer mode: emit 256KB + marker to stdout, exit clean.
     * Direct fwrite (no shell, no powershell) so the test isolates the
     * PTY layer from any interpreter cold-start. */
    static const char chunk[8] = {'0','1','2','3','4','5','6','7'};
    for (int i = 0; i < 32768; i++) {
        if (fwrite(chunk, 1, 8, stdout) != 8) return 1;
    }
    if (fwrite(MARKER, 1, MARKER_LEN, stdout) != MARKER_LEN) return 1;
    if (fflush(stdout) != 0) return 1;
    return 0;
}

static size_t   g_received   = 0;
static int      g_marker_seen = 0;
static char     g_tail[16];   /* rolling window for marker scan */

static int contains_marker(const char *buf, size_t len) {
    if (len < MARKER_LEN) return 0;
    for (size_t i = 0; i + MARKER_LEN <= len; i++) {
        if (memcmp(buf + i, MARKER, MARKER_LEN) == 0) return 1;
    }
    return 0;
}

static void on_pty_data(void *cd) {
    PTYHandle *h = (PTYHandle *)cd;
    uint8_t buf[4096];
    for (;;) {
        pty_ssize_t n = pty_read(h, buf, sizeof buf);
        if (n <= 0) break;  /* EAGAIN (-1) or EOF (0) */
        g_received += (size_t)n;
        /* Update rolling tail to detect MARKER even if it straddles
         * read boundaries. */
        for (pty_ssize_t i = 0; i < n; i++) {
            memmove(g_tail, g_tail + 1, sizeof g_tail - 1);
            g_tail[sizeof g_tail - 1] = (char)buf[i];
            if (!g_marker_seen && contains_marker(g_tail, sizeof g_tail)) {
                g_marker_seen = 1;
            }
        }
    }
}

int main(int argc, char *argv[]) {
    if (argc > 1 && strcmp(argv[1], "--emit") == 0) {
        return run_emitter();
    }

    Tcl_FindExecutable(argv[0]);
    Tcl_Interp *interp = Tcl_CreateInterp();
    phc_check(interp != NULL, "Tcl_CreateInterp returned NULL");

    /* Spawn ourself in --emit mode through pty.phc. ConPTY (Win) and
     * forkpty (POSIX) launch the .exe / executable directly with no
     * shell wrapper — producer cold-start budget is minimal. */
    const char *self = Tcl_GetNameOfExecutable();
    phc_check(self != NULL && self[0] != 0,
              "Tcl_GetNameOfExecutable returned empty path");
    char *child_argv[] = {
        (char *)self,
        "--emit",
        NULL
    };

    PTYHandle *h = pty_open(child_argv, 24, 80);
    phc_check(h != NULL, "pty_open returned NULL");
    int rc = pty_install_tcl_handler(h, interp, on_pty_data, h);
    phc_check(rc == TCL_OK, "pty_install_tcl_handler != TCL_OK");

    /* Drain events until marker observed or 60s timeout. 60s is the
     * upper bound for CI cold-start of the producer + ConPTY on a slow
     * Win runner; direct-exec budget is well under this. */
    const int max_loops = 6000;  /* 6000 * 10ms = 60s */
    for (int i = 0; i < max_loops; i++) {
        Tcl_DoOneEvent(TCL_FILE_EVENTS | TCL_IDLE_EVENTS | TCL_DONT_WAIT);
        if (g_marker_seen) {
            /* Drain any remaining bytes after marker so the count
             * reflects everything the producer emitted before EOF. */
            on_pty_data(h);
            break;
        }
        if (pty_eof(h)) {
            /* Producer closed; one final drain to capture trailing
             * bytes (including MARKER if it landed in the last chunk). */
            on_pty_data(h);
            break;
        }
#if defined(_WIN32)
        Sleep(10);
#else
        struct timespec ts = {0, 10 * 1000 * 1000};  /* 10ms */
        nanosleep(&ts, NULL);
#endif
    }

    pty_kill(h);
    pty_free(h);
    Tcl_DeleteInterp(interp);

    if (!g_marker_seen) {
        fprintf(stderr,
                "FAIL: marker not seen within timeout (received %zu bytes; "
                "expected >= %u + marker). Direct-exec producer; fault is "
                "in the PTY layer (pty_open / Tcl integration / read pump).\n",
                g_received, BURST_BYTES);
        return 2;
    }
    if (g_received < BURST_BYTES) {
        fprintf(stderr,
                "FAIL: short read (received %zu bytes; expected >= %u). "
                "Indicates ring backpressure or read-pump dropped bytes "
                "mid-burst.\n",
                g_received, BURST_BYTES);
        return 3;
    }
    fprintf(stderr,
            "test_pty_burst ok: received %zu bytes, marker observed "
            "(>= %u-byte payload + MARKER, no drops).\n",
            g_received, BURST_BYTES);
    return 0;
}
