/*
 * test_compute_layout.phc — A2 origin + bbox-calibration regression anchor
 *
 * Per supervisor 2026-05-13 09:47:45 + alexie 09:46:53 automated-suite
 * directive. Discriminator for the A2 port:
 *  - if alexie reports asymmetric slop AND this passes, bug is in
 *    something downstream of compute_layout (render origin application,
 *    canvas geometry, resize handler not firing) — not the centering math
 *  - if alexie reports 'cols runaway / line-wrap broken' AND this
 *    passes, bug is in bbox_calibrate's Tk bbox query OR the row0 tag
 *    binding, not the asymmetric WIDEN rule
 *  - if this fails, regression is inside the centering formula or the
 *    asymmetric WIDEN rule which are the load-bearing safety bounds
 *
 * Approach — SPEC COPY of the math fragments from p3_pty.phc compute_layout
 * + bbox_calibrate. Production functions are tangled with Tcl_Eval (winfo
 * width, .c bbox row0) — extracting just the math is the only way to test
 * pure-C without a Tk init.
 *
 * Drift between this spec copy and production is itself a bug,
 * catchable at next p3_pty.phc layout review.
 *
 * Headless (libc only); no Tcl/Tk/PTY/screen.phc link.
 */

#include <stdio.h>
#include <string.h>

#define NBS_PADDING 4

/* SPEC COPY — compute_layout centering math from src/p3_pty.phc.
 * Returns new_x + new_y for given inputs. Production also writes
 * g_origin_x/g_origin_y + returns 'changed'; test only validates the math.
 *
 * Centering basis is the cell grid (cols * g_cell_w), not the widest
 * painted row. cols/rows track the canvas on <Configure> (do_pty_resize
 * + reflow path), so canvas_w ≈ cols * g_cell_w within g_cell_w-1 pixels;
 * margins land symmetric ≤1 cell per side regardless of content density
 * (alexie 2026-05-20 09:26:53Z reframe + #5 right-slop fix). Replaces
 * prior 'centre on max painted-row width, capped at 2 * g_cell_w' which
 * pinned origin near the left edge on sparse rows. */
static void compute_layout_spec(int canvas_w, int canvas_h, int cols, int rows,
                                int g_cell_w, int g_cell_h,
                                int *out_x, int *out_y) {
    int new_x, new_y;
    if (cols < 1 || canvas_w == 0 || canvas_h == 0) {
        new_x = NBS_PADDING;
        new_y = NBS_PADDING;
    } else {
        int grid_w = cols * g_cell_w;
        int text_h = rows * g_cell_h;
        new_x = (canvas_w - grid_w) / 2;
        new_y = (canvas_h - text_h) / 2;
        if (new_x < 0) new_x = 0;
        if (new_y < 0) new_y = 0;
    }
    *out_x = new_x;
    *out_y = new_y;
}

/* SPEC COPY — bbox_calibrate WIDEN rule from src/p3_pty.phc.
 * Production path queries Tk for bbox; this tests the post-bbox math.
 * Returns new g_cell_w (== input if not widened, else effective). */
static int bbox_calibrate_spec(int x1, int x2, int cols, int g_cell_w) {
    int eff = (x2 - x1) / cols;
    if (eff > g_cell_w) return eff;
    return g_cell_w;
}

static int eq_xy(int gx, int gy, int wx, int wy, const char *label) {
    if (gx == wx && gy == wy) return 0;
    printf("FAIL %s: got (%d,%d) want (%d,%d)\n", label, gx, gy, wx, wy);
    return 1;
}

int main(void) {
    int fail = 0;
    int x, y;

    /* === Cold-start fallback (any zero/invalid input -> PADDING) === */

    compute_layout_spec(0, 0, 0, 24, 9, 18, &x, &y);
    fail += eq_xy(x, y, NBS_PADDING, NBS_PADDING, "cold start: all zero");

    compute_layout_spec(800, 0, 80, 24, 9, 18, &x, &y);
    fail += eq_xy(x, y, NBS_PADDING, NBS_PADDING, "cold start: canvas_h=0");

    compute_layout_spec(0, 600, 80, 24, 9, 18, &x, &y);
    fail += eq_xy(x, y, NBS_PADDING, NBS_PADDING, "cold start: canvas_w=0");

    compute_layout_spec(800, 600, 0, 24, 9, 18, &x, &y);
    fail += eq_xy(x, y, NBS_PADDING, NBS_PADDING, "cold start: cols=0");

    /* === Resize-tracking case: canvas_w ≈ cols * g_cell_w === */

    /* canvas_w=800, cols=88, g_cell_w=9 → grid_w=792. margin=(800-792)/2=4.
     * text_h=24*18=432; new_y=(600-432)/2=84. */
    compute_layout_spec(800, 600, 88, 24, 9, 18, &x, &y);
    fail += eq_xy(x, y, 4, 84, "canvas tracks grid: small symmetric margin");

    /* canvas_w=800, cols=89, g_cell_w=9 → grid_w=801. margin=(800-801)/2=-1
     * C integer division truncates toward zero → -1/2 = 0; clamp also 0. */
    compute_layout_spec(800, 600, 89, 24, 9, 18, &x, &y);
    fail += eq_xy(x, y, 0, 84, "grid slightly wider than canvas: clamp 0");

    /* === Stale cols vs canvas (resize handler hasn't fired yet) === */

    /* canvas_w=1600, cols=80, g_cell_w=9 → grid_w=720. margin=(1600-720)/2=440.
     * Tests the formula; in production cols would resize to ~177 first. */
    compute_layout_spec(1600, 600, 80, 24, 9, 18, &x, &y);
    fail += eq_xy(x, y, 440, 84, "stale cols, wide canvas: large symmetric margin");

    /* === Overflow clamp (grid wider than canvas) === */

    /* canvas_w=100, cols=80, g_cell_w=9 → grid_w=720. margin=-310; clamp 0. */
    compute_layout_spec(100, 600, 80, 24, 9, 18, &x, &y);
    fail += eq_xy(x, y, 0, 84, "grid overflows canvas: x clamped to 0");

    /* === Vertical overflow clamp === */

    /* 100 rows * 18 = 1800 text_h; canvas_h=600 → -600 → clamp 0.
     * cols=80, g_cell_w=9 → grid_w=720; margin=(800-720)/2=40. */
    compute_layout_spec(800, 600, 80, 100, 9, 18, &x, &y);
    fail += eq_xy(x, y, 40, 0, "text taller than canvas: y clamped to 0");

    /* === Cell size variants === */

    /* Tiny cell: g_cell_w=1, cols=80 → grid_w=80; margin=(800-80)/2=360. */
    compute_layout_spec(800, 600, 80, 24, 1, 18, &x, &y);
    fail += eq_xy(x, y, 360, 84, "tiny cell width: large margin");

    /* Large cell: g_cell_w=100, cols=8 → grid_w=800; margin=0. */
    compute_layout_spec(800, 600, 8, 24, 100, 18, &x, &y);
    fail += eq_xy(x, y, 0, 84, "large cell, grid fills canvas: x=0");

    /* === Row count edges === */

    /* 0 rows: text_h=0; new_y=canvas_h/2=300. cols=80, g_cell_w=9 → x=40. */
    compute_layout_spec(800, 600, 80, 0, 9, 18, &x, &y);
    fail += eq_xy(x, y, 40, 300, "zero rows: y center of canvas");

    /* 1 row: text_h=18; new_y=(600-18)/2=291. */
    compute_layout_spec(800, 600, 80, 1, 9, 18, &x, &y);
    fail += eq_xy(x, y, 40, 291, "one row: y near center");

    /* === Independence from content density (cols is the basis, not max_w) === */

    /* Same cols/rows/cells in two calls — no max_w parameter; result is
     * a pure function of (canvas, cols, rows, cell metrics). Sparse vs
     * dense painted content has zero effect on origin. */
    int x2, y2;
    compute_layout_spec(800, 600, 80, 24, 9, 18, &x, &y);
    compute_layout_spec(800, 600, 80, 24, 9, 18, &x2, &y2);
    if (x != x2 || y != y2) {
        printf("FAIL determinism: (%d,%d) vs (%d,%d)\n", x, y, x2, y2);
        fail++;
    }

    /* === bbox_calibrate WIDEN (asymmetric) === */

    /* eff = (900-0)/100 = 9; g_cell_w = 9; eff NOT > g_cell_w; no widen */
    int new_w;
    new_w = bbox_calibrate_spec(0, 900, 100, 9);
    if (new_w != 9) { printf("FAIL bbox no-widen: got %d want 9\n", new_w); fail++; }

    /* eff = (1000-0)/100 = 10; g_cell_w = 9; eff > -> widen to 10 */
    new_w = bbox_calibrate_spec(0, 1000, 100, 9);
    if (new_w != 10) { printf("FAIL bbox widen 9->10: got %d want 10\n", new_w); fail++; }

    /* eff = (800-0)/100 = 8; g_cell_w = 9; eff < -> NO shrink (asymmetric) */
    new_w = bbox_calibrate_spec(0, 800, 100, 9);
    if (new_w != 9) { printf("FAIL bbox no-shrink: got %d want 9 (asymmetric)\n", new_w); fail++; }

    /* eff = (1100-100)/100 = 10; g_cell_w = 5; widen to 10 */
    new_w = bbox_calibrate_spec(100, 1100, 100, 5);
    if (new_w != 10) { printf("FAIL bbox widen with offset: got %d want 10\n", new_w); fail++; }

    /* Equality boundary: eff == g_cell_w; NO widen (>, not >=) */
    new_w = bbox_calibrate_spec(0, 900, 100, 9);
    if (new_w != 9) { printf("FAIL bbox eq-boundary: got %d want 9 (eq is not >)\n", new_w); fail++; }

    if (fail == 0) {
        printf("test_compute_layout: PASS (19 cases)\n");
        return 0;
    }
    printf("test_compute_layout: FAIL (%d failures)\n", fail);
    return 1;
}
