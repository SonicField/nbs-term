/*
 * test_compute_layout.phc — A2 origin + bbox-calibration regression anchor
 *
 * Per supervisor 2026-05-13 09:47:45 + alexie 09:46:53 automated-suite
 * directive. Discriminator for the A2 port (commit b37fcd1):
 *  - if alexie reports 'text glued to top-left or right-edge' AND this
 *    passes, bug is in compute_layout's font.measure walk OR view_row_cells
 *    composite path, not the centering math
 *  - if alexie reports 'cols runaway / line-wrap broken' AND this
 *    passes, bug is in bbox_calibrate's Tk bbox query OR the row0 tag
 *    binding, not the asymmetric WIDEN rule
 *  - if this fails, regression is inside the post-measurement clamp
 *    formula (slop-cap, centering, cold-start fallback, asymmetric
 *    WIDEN) which is the load-bearing safety bound
 *
 * Approach — SPEC COPY of the math fragments from p3_pty.phc:464-481
 * (compute_layout post-measurement clamp) + 502-510 (bbox_calibrate
 * widen). Production functions are tangled with Tcl_Eval (winfo width,
 * font measure, .c bbox row0) — extracting just the math is the only
 * way to test pure-C without a Tk init, and the math IS the load-bearing
 * regression surface (theologian_branch_tree_bug_c.md trap = wrong
 * formula here breaks Mac slop on aqua).
 *
 * Drift between this spec copy and production is itself a bug,
 * catchable at next p3_pty.phc layout review.
 *
 * Headless (libc only); no Tcl/Tk/PTY/screen.phc link.
 */

#include <stdio.h>
#include <string.h>

#define NBS_PADDING 4

/* SPEC COPY — compute_layout post-measurement clamp from
 * src/p3_pty.phc:464-481. Returns new_x + new_y for given inputs.
 * Production also writes g_origin_x/g_origin_y + returns 'changed';
 * test only validates the math.
 *
 * Cap removed entirely per alexie 2026-05-13 14:51:46 framework
 * ('measure real numbers, scale with window') + supervisor
 * 14:53:12 option (i) routing. Pure (canvas_w - max_w) / 2
 * centering, clamp to >=0 only. */
static void compute_layout_spec(int canvas_w, int canvas_h, int max_w,
                                int g_cell_w, int g_cell_h, int rows,
                                int *out_x, int *out_y) {
    (void)g_cell_w;  /* no longer used — cap removed */
    int new_x, new_y;
    if (max_w == 0 || canvas_w == 0 || canvas_h == 0) {
        new_x = NBS_PADDING;
        new_y = NBS_PADDING;
    } else {
        new_x = (canvas_w - max_w) / 2;
        if (new_x < 0) new_x = 0;
        int text_h = rows * g_cell_h;
        new_y = (canvas_h - text_h) / 2;
        if (new_y < 0) new_y = 0;
    }
    *out_x = new_x;
    *out_y = new_y;
}

/* SPEC COPY — bbox_calibrate WIDEN rule from src/p3_pty.phc:502-510.
 * Production path queries Tk for bbox; this tests the post-bbox math.
 * Returns new g_cell_w (== input if not widened, else effective). */
static int bbox_calibrate_spec(int x1, int x2, int cols, int g_cell_w) {
    int eff = (x2 - x1) / cols;
    if (eff > g_cell_w) return eff;
    return g_cell_w;
}

static int eq_xy(int gx, int gy, int wx, int wy, const char *label) {
    if (gx == wx && gy == wy) return 0;
    printf("FAIL %s: got (%d,%d) want (%d,%d)\n", label, gx, gy, wx, wy);
    return 1;
}

int main(void) {
    int fail = 0;
    int x, y;

    /* === compute_layout cold-start fallback (any zero input -> PADDING) === */

    compute_layout_spec(0, 0, 0, 9, 18, 24, &x, &y);
    fail += eq_xy(x, y, NBS_PADDING, NBS_PADDING, "cold start: all zero");

    compute_layout_spec(800, 0, 100, 9, 18, 24, &x, &y);
    fail += eq_xy(x, y, NBS_PADDING, NBS_PADDING, "cold start: canvas_h=0");

    compute_layout_spec(0, 600, 100, 9, 18, 24, &x, &y);
    fail += eq_xy(x, y, NBS_PADDING, NBS_PADDING, "cold start: canvas_w=0");

    compute_layout_spec(800, 600, 0, 9, 18, 24, &x, &y);
    fail += eq_xy(x, y, NBS_PADDING, NBS_PADDING, "cold start: max_w=0 (no text)");

    /* === compute_layout pure (canvas_w - max_w) / 2 centering === */

    /* Text 100px wide in 800px canvas: x = (800-100)/2 = 350.
     * No cap; pure half-width centering. */
    compute_layout_spec(800, 600, 100, 9, 18, 24, &x, &y);
    /* text_h = 24*18 = 432; new_y = (600-432)/2 = 84 */
    fail += eq_xy(x, y, 350, 84, "narrow text -> centered, no cap");

    /* Text 780px wide in 800px canvas: x = (800-780)/2 = 10. */
    compute_layout_spec(800, 600, 780, 9, 18, 24, &x, &y);
    fail += eq_xy(x, y, 10, 84, "wide text -> small left margin");

    /* Edge: text exactly fills canvas: x = 0 */
    compute_layout_spec(800, 600, 800, 9, 18, 24, &x, &y);
    fail += eq_xy(x, y, 0, 84, "text fills canvas: x=0");

    /* === compute_layout clamp (text wider than canvas) === */

    /* Text 900px wide in 800px canvas: x = (800-900)/2 = -50 -> clamp 0 */
    compute_layout_spec(800, 600, 900, 9, 18, 24, &x, &y);
    fail += eq_xy(x, y, 0, 84, "text overflows canvas: x clamped to 0");

    /* === compute_layout vertical clamp (text taller than canvas) === */

    /* 100 rows * 18 = 1800 text_h; canvas_h=600 -> (600-1800)/2 = -600 -> clamp 0 */
    compute_layout_spec(800, 600, 100, 9, 18, 100, &x, &y);
    fail += eq_xy(x, y, 350, 0, "text taller than canvas: y clamped to 0");

    /* === g_cell_w doesn't affect origin (cap removed) === */

    compute_layout_spec(800, 600, 100, 1, 18, 24, &x, &y);
    fail += eq_xy(x, y, 350, 84, "tiny cell, narrow text -> still centered");

    compute_layout_spec(800, 600, 100, 100, 18, 24, &x, &y);
    fail += eq_xy(x, y, 350, 84, "large cell, narrow text -> still centered");

    /* === wide canvas: more margin both sides === */

    /* canvas_w=1600, max_w=800: x = (1600-800)/2 = 400. Symmetric
     * centering on wide window — alexie 14:51:46 directive. */
    compute_layout_spec(1600, 600, 800, 9, 18, 24, &x, &y);
    fail += eq_xy(x, y, 400, 84, "wide canvas, half-width text -> symmetric");

    /* === tiny canvas === */

    /* canvas_w=80, max_w=20: x = (80-20)/2 = 30. */
    compute_layout_spec(80, 600, 20, 9, 18, 24, &x, &y);
    fail += eq_xy(x, y, 30, 84, "tiny canvas -> small centered");

    /* === compute_layout y-centering with various row counts === */

    /* 0 rows: text_h = 0; new_y = canvas_h/2 = 300 */
    compute_layout_spec(800, 600, 100, 9, 18, 0, &x, &y);
    fail += eq_xy(x, y, 350, 300, "zero rows -> y center of canvas");

    /* 1 row: text_h = 18; new_y = (600-18)/2 = 291 */
    compute_layout_spec(800, 600, 100, 9, 18, 1, &x, &y);
    fail += eq_xy(x, y, 350, 291, "one row -> y near center");

    /* === bbox_calibrate WIDEN (asymmetric) === */

    /* eff = (900-0)/100 = 9; g_cell_w = 9; eff NOT > g_cell_w; no widen */
    int new_w;
    new_w = bbox_calibrate_spec(0, 900, 100, 9);
    if (new_w != 9) { printf("FAIL bbox no-widen: got %d want 9\n", new_w); fail++; }

    /* eff = (1000-0)/100 = 10; g_cell_w = 9; eff > -> widen to 10 */
    new_w = bbox_calibrate_spec(0, 1000, 100, 9);
    if (new_w != 10) { printf("FAIL bbox widen 9->10: got %d want 10\n", new_w); fail++; }

    /* eff = (800-0)/100 = 8; g_cell_w = 9; eff < -> NO shrink (asymmetric) */
    new_w = bbox_calibrate_spec(0, 800, 100, 9);
    if (new_w != 9) { printf("FAIL bbox no-shrink: got %d want 9 (asymmetric)\n", new_w); fail++; }

    /* eff = (1100-100)/100 = 10; g_cell_w = 5; widen to 10 */
    new_w = bbox_calibrate_spec(100, 1100, 100, 5);
    if (new_w != 10) { printf("FAIL bbox widen with offset: got %d want 10\n", new_w); fail++; }

    /* Equality boundary: eff == g_cell_w; NO widen (>, not >=) */
    new_w = bbox_calibrate_spec(0, 900, 100, 9);
    if (new_w != 9) { printf("FAIL bbox eq-boundary: got %d want 9 (eq is not >)\n", new_w); fail++; }

    if (fail == 0) {
        printf("test_compute_layout: PASS (20 cases)\n");
        return 0;
    }
    printf("test_compute_layout: FAIL (%d failures)\n", fail);
    return 1;
}
