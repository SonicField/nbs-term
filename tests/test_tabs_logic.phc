/*
 * test_tabs_logic.phc — tab manager next-active + cycle decision logic
 *
 * Per pythia #101 + supervisor 2026-05-14 11:07:57 (1) — '-test
 * exercises slot-0 boot path only. Tabs.b adds 2-tab self-test (or
 * test_tabs.phc spec-copy of select_tab decision logic) discharging
 * the transition on Linux'.
 *
 * Discriminator for the tab dispatch decisions in src/p3_pty.phc:
 *  - if close_tab next-active picker returns wrong slot when the
 *    active tab closes -> active swap stalls or jumps to a freed
 *    slot (Cmd+W on tab N leaves a phantom active or selects a
 *    closed tab)
 *  - if NbsNextTab/NbsPrevTab cycle skips active slots OR loops
 *    forever on all-inactive -> Ctrl+Tab does nothing or hangs
 *  - if last-active detection (alive==0) fires when one tab still
 *    active -> Cmd+W on second-to-last tab unexpectedly exits
 *    the program
 *
 * Approach — SPEC COPY of two pure-C decision functions extracted
 * from src/p3_pty.phc:
 *  (a) close_tab next-active picker (returns next active idx after
 *      closing 'closing_idx' when 'closing_idx == active_idx')
 *  (b) next_tab / prev_tab cycle (returns next/prev active slot
 *      after current active_idx, wrapping mod tab_count)
 * Production helpers are tangled with Tcl_Eval + g_tabs[] state;
 * SPEC COPY tests the decision math against a small bool array
 * mimicking g_tabs[i].active.
 *
 * Headless (libc only); no Tcl/Tk/PTY/screen.phc link.
 */

#include <stdio.h>
#include <string.h>

/* SPEC COPY — close_tab next-active picker from src/p3_pty.phc.
 * Given the active-flag array + tab count + the active idx + the
 * idx being closed, returns:
 *   -2 = special: no active slots remain after close (caller
 *        should signal child_done=1)
 *   -1 = no next swap needed (closing a non-active slot)
 *   >=0 = next active idx to switch to (only valid when closing
 *        the currently-active slot)
 *
 * Picks the IMMEDIATE next active slot after closing_idx (wrapping
 * mod tab_count) per Mac Terminal / iTerm UX convention. */
static int close_tab_next_active_spec(const int *active_flag, int tab_count,
                                       int active_idx, int closing_idx) {
    if (closing_idx < 0 || closing_idx >= tab_count) return -1;
    /* Simulate the active flag flip (closing_idx becomes 0). */
    int alive = 0;
    for (int i = 0; i < tab_count; i++) {
        int flag = (i == closing_idx) ? 0 : active_flag[i];
        if (flag) alive++;
    }
    if (alive == 0) return -2;
    if (closing_idx != active_idx) return -1;
    /* Find immediate next active after closing_idx, wrapping. */
    for (int step = 1; step < tab_count; step++) {
        int candidate = (closing_idx + step) % tab_count;
        int flag = (candidate == closing_idx) ? 0 : active_flag[candidate];
        if (flag) return candidate;
    }
    return -1;
}

/* SPEC COPY — NbsNextTab cycle logic. Returns the next active slot
 * after 'active_idx', wrapping around mod 'tab_count'. Returns -1 if
 * no other active slot exists (single-tab session).  */
static int next_tab_cycle_spec(const int *active_flag, int tab_count,
                                int active_idx) {
    int active_count = 0;
    for (int i = 0; i < tab_count; i++) if (active_flag[i]) active_count++;
    if (active_count <= 1) return -1;
    int next = active_idx;
    for (int step = 0; step < tab_count; step++) {
        next = (next + 1) % tab_count;
        if (active_flag[next]) return next;
    }
    return -1;
}

/* SPEC COPY — NbsPrevTab cycle (mirror of next_tab_cycle_spec). */
static int prev_tab_cycle_spec(const int *active_flag, int tab_count,
                                int active_idx) {
    int active_count = 0;
    for (int i = 0; i < tab_count; i++) if (active_flag[i]) active_count++;
    if (active_count <= 1) return -1;
    int prev = active_idx;
    for (int step = 0; step < tab_count; step++) {
        prev = (prev - 1 + tab_count) % tab_count;
        if (active_flag[prev]) return prev;
    }
    return -1;
}

static int eq_int(int got, int want, const char *label) {
    if (got == want) return 0;
    printf("FAIL %s: got %d want %d\n", label, got, want);
    return 1;
}

int main(void) {
    int fail = 0;

    /* === close_tab: closing the active slot, next active is later === */
    {
        int flags[3] = {1, 1, 1};   /* 3 active tabs */
        fail += eq_int(close_tab_next_active_spec(flags, 3, 1, 1), 2,
                       "close active tab 1 of 3 -> next is 2");
    }

    /* === close_tab: closing the active slot at end, next wraps to earlier === */
    {
        int flags[3] = {1, 1, 1};
        fail += eq_int(close_tab_next_active_spec(flags, 3, 2, 2), 0,
                       "close active tab 2 (last) of 3 -> next is 0 (earliest active)");
    }

    /* === close_tab: closing an inactive slot -> no swap needed === */
    {
        int flags[3] = {1, 0, 1};   /* tab 1 already closed */
        fail += eq_int(close_tab_next_active_spec(flags, 3, 0, 1), -1,
                       "close already-inactive tab -> no swap");
    }

    /* === close_tab: closing a non-active slot while active stays === */
    {
        int flags[3] = {1, 1, 1};
        fail += eq_int(close_tab_next_active_spec(flags, 3, 0, 2), -1,
                       "close non-active tab 2 while active is 0 -> no swap");
    }

    /* === close_tab: closing the last active slot -> -2 (signal exit) === */
    {
        int flags[3] = {0, 1, 0};   /* only tab 1 active */
        fail += eq_int(close_tab_next_active_spec(flags, 3, 1, 1), -2,
                       "close last-active tab -> -2 (exit signal)");
    }

    /* === close_tab: skip-over closed slot when picking next active === */
    {
        int flags[4] = {1, 0, 1, 1};   /* tab 1 is a freed slot */
        fail += eq_int(close_tab_next_active_spec(flags, 4, 0, 0), 2,
                       "close active tab 0; tab 1 freed; next active is 2 not 1");
    }

    /* === next_tab_cycle: wraps around === */
    {
        int flags[3] = {1, 1, 1};
        fail += eq_int(next_tab_cycle_spec(flags, 3, 0), 1,
                       "next from 0 of 3 -> 1");
        fail += eq_int(next_tab_cycle_spec(flags, 3, 2), 0,
                       "next from 2 of 3 -> wraps to 0");
    }

    /* === next_tab_cycle: skips inactive slots === */
    {
        int flags[4] = {1, 0, 1, 0};   /* tabs 1 + 3 freed */
        fail += eq_int(next_tab_cycle_spec(flags, 4, 0), 2,
                       "next from 0 with tab 1 freed -> 2 (skip)");
        fail += eq_int(next_tab_cycle_spec(flags, 4, 2), 0,
                       "next from 2 with tab 3 freed -> wraps to 0");
    }

    /* === next_tab_cycle: single-tab returns -1 (no-op) === */
    {
        int flags[3] = {1, 0, 0};
        fail += eq_int(next_tab_cycle_spec(flags, 3, 0), -1,
                       "next from single-active-tab -> -1 (no cycle)");
    }

    /* === next_tab_cycle: all-inactive returns -1 === */
    {
        int flags[3] = {0, 0, 0};
        fail += eq_int(next_tab_cycle_spec(flags, 3, 0), -1,
                       "next from all-inactive -> -1");
    }

    /* === prev_tab_cycle: mirror of next === */
    {
        int flags[3] = {1, 1, 1};
        fail += eq_int(prev_tab_cycle_spec(flags, 3, 0), 2,
                       "prev from 0 of 3 -> wraps to 2");
        fail += eq_int(prev_tab_cycle_spec(flags, 3, 2), 1,
                       "prev from 2 of 3 -> 1");
    }

    /* === prev_tab_cycle: skips inactive === */
    {
        int flags[4] = {1, 0, 1, 0};
        fail += eq_int(prev_tab_cycle_spec(flags, 4, 2), 0,
                       "prev from 2 with tab 1 freed -> 0 (skip)");
        fail += eq_int(prev_tab_cycle_spec(flags, 4, 0), 2,
                       "prev from 0 with tab 3 freed -> wraps to 2");
    }

    /* === prev_tab_cycle: single-active returns -1 === */
    {
        int flags[3] = {0, 1, 0};
        fail += eq_int(prev_tab_cycle_spec(flags, 3, 1), -1,
                       "prev from single-active -> -1");
    }

    if (fail == 0) {
        printf("test_tabs_logic: PASS (16 cases)\n");
        return 0;
    }
    printf("test_tabs_logic: FAIL (%d failures)\n", fail);
    return 1;
}
