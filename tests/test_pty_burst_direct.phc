/*
 * test_pty_burst_direct.phc — (iii) probe per supervisor 2026-05-05 18:23:08
 * "shift the probe" branch + 02:42:46 fallback activation.
 *
 * (a) What this probe falsifies:
 *     The powershell-startup hypothesis specifically. test_pty_burst on
 *     b8f03fb Win CI got rc=2 (timeout, 85 bytes / 262157 in 60s) — the
 *     2+fail DIAGNOSIS class names "runner-environment latency or
 *     producer-side issue" and explicitly cannot discriminate PTY vs
 *     Tk. The leading hypothesis is that powershell -NoProfile cold-
 *     start under cmd.exe in CI is the bottleneck.
 *
 * (b) Why test_pty_burst couldn't isolate it:
 *     test_pty_burst's producer IS powershell ($s='01234567'*32768;
 *     [Console]::Out.Write($s)). It cannot observe its own startup
 *     as the bottleneck — that confounds the test. Different probe,
 *     different producer mechanism, removes powershell entirely.
 *
 * Mechanism:
 *     This binary has two modes. With --emit it runs as a producer
 *     and writes 256KB + MARKER directly to stdout, then exits. With
 *     no args it runs as the test driver: spawns ITSELF via pty_open
 *     (no cmd.exe wrapper, no powershell — ConPTY launches the .exe
 *     directly on Win, execvp on POSIX), drains via pty_read in a
 *     Tcl event loop, asserts marker arrives + count >= BURST_BYTES.
 *
 * Discrimination outcomes (Win):
 *     test_pty_burst_direct PASS + test_pty_burst FAIL → powershell
 *         startup IS the bottleneck. Fix lives in the producer choice,
 *         not in pty.phc / ConPTY.
 *     test_pty_burst_direct FAIL + test_pty_burst FAIL → fault is in
 *         pty.phc / ConPTY layer (matches the "PTY/ConPTY layer"
 *         diagnosis the matrix could not previously confirm).
 *     test_pty_burst_direct FAIL + test_pty_burst PASS → unusual;
 *         direct-exec exposes a path the powershell wrapper masks.
 *
 * Build: make build/test_pty_burst_direct
 * Run:   build/test_pty_burst_direct        (test driver)
 *        build/test_pty_burst_direct --emit (producer; for the driver
 *                                            to spawn — not a user-
 *                                            facing mode)
 */

#if !defined(_WIN32)
#  ifndef _DEFAULT_SOURCE
#    define _DEFAULT_SOURCE 1
#  endif
#  ifndef _POSIX_C_SOURCE
#    define _POSIX_C_SOURCE 200809L
#  endif
#endif

#include <tcl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#if !defined(_WIN32)
#  include <unistd.h>
#  include <time.h>
#endif

#define phc_require(expr, msg) do { if (!(expr)) { \
    fprintf(stderr, "REQUIRE FAILED %s:%d: %s\n", __FILE__, __LINE__, msg); \
    abort(); }} while(0)
#define phc_check(expr, msg) do { if (!(expr)) { \
    fprintf(stderr, "CHECK FAILED %s:%d: %s\n", __FILE__, __LINE__, msg); \
    abort(); }} while(0)
#define phc_invariant(expr, msg) do { if (!(expr)) { \
    fprintf(stderr, "INVARIANT FAILED %s:%d: %s\n", __FILE__, __LINE__, msg); \
    abort(); }} while(0)

#include "pty.phc"

#define BURST_BYTES 262144
#define MARKER "PHC_BURST_END"
#define MARKER_LEN 13

static int run_emitter(void) {
    /* Producer mode: emit 256KB + marker to stdout, exit clean.
     * Direct fwrite (no shell, no powershell) so the test isolates the
     * PTY layer from any interpreter cold-start. */
    static const char chunk[8] = {'0','1','2','3','4','5','6','7'};
    for (int i = 0; i < 32768; i++) {
        if (fwrite(chunk, 1, 8, stdout) != 8) return 1;
    }
    if (fwrite(MARKER, 1, MARKER_LEN, stdout) != MARKER_LEN) return 1;
    if (fflush(stdout) != 0) return 1;
    return 0;
}

static size_t   g_received   = 0;
static int      g_marker_seen = 0;
static char     g_tail[16];

static int contains_marker(const char *buf, size_t len) {
    if (len < MARKER_LEN) return 0;
    for (size_t i = 0; i + MARKER_LEN <= len; i++) {
        if (memcmp(buf + i, MARKER, MARKER_LEN) == 0) return 1;
    }
    return 0;
}

static void on_pty_data(void *cd) {
    PTYHandle *h = (PTYHandle *)cd;
    uint8_t buf[4096];
    for (;;) {
        pty_ssize_t n = pty_read(h, buf, sizeof buf);
        if (n <= 0) break;
        g_received += (size_t)n;
        for (pty_ssize_t i = 0; i < n; i++) {
            memmove(g_tail, g_tail + 1, sizeof g_tail - 1);
            g_tail[sizeof g_tail - 1] = (char)buf[i];
            if (!g_marker_seen && contains_marker(g_tail, sizeof g_tail)) {
                g_marker_seen = 1;
            }
        }
    }
}

int main(int argc, char *argv[]) {
    if (argc > 1 && strcmp(argv[1], "--emit") == 0) {
        return run_emitter();
    }

    Tcl_FindExecutable(argv[0]);
    Tcl_Interp *interp = Tcl_CreateInterp();
    phc_check(interp != NULL, "Tcl_CreateInterp returned NULL");

    /* Spawn ourself in --emit mode through pty.phc. ConPTY (Win) and
     * forkpty (POSIX) launch the .exe / executable directly with no
     * shell wrapper, no powershell — falsifies the powershell-startup
     * hypothesis if PASS, isolates fault to PTY layer if FAIL. */
    const char *self = Tcl_GetNameOfExecutable();
    phc_check(self != NULL && self[0] != 0,
              "Tcl_GetNameOfExecutable returned empty path");
    char *child_argv[] = {
        (char *)self,
        "--emit",
        NULL
    };

    PTYHandle *h = pty_open(child_argv, 24, 80);
    phc_check(h != NULL, "pty_open returned NULL");
    int rc = pty_install_tcl_handler(h, interp, on_pty_data, h);
    phc_check(rc == TCL_OK, "pty_install_tcl_handler != TCL_OK");

    /* 60s ceiling matches test_pty_burst.phc post-#48; producer is
     * direct exec so cold-start budget is much smaller. */
    const int max_loops = 6000;  /* 6000 * 10ms = 60s */
    for (int i = 0; i < max_loops; i++) {
        Tcl_DoOneEvent(TCL_FILE_EVENTS | TCL_IDLE_EVENTS | TCL_DONT_WAIT);
        if (g_marker_seen) {
            on_pty_data(h);
            break;
        }
        if (pty_eof(h)) {
            on_pty_data(h);
            break;
        }
#if defined(_WIN32)
        Sleep(10);
#else
        struct timespec ts = {0, 10 * 1000 * 1000};
        nanosleep(&ts, NULL);
#endif
    }

    pty_kill(h);
    pty_free(h);
    Tcl_DeleteInterp(interp);

    if (!g_marker_seen) {
        fprintf(stderr,
                "FAIL: marker not seen within timeout (received %zu bytes; "
                "expected >= %u + marker). Direct-exec producer also failed "
                "→ fault is NOT powershell-startup; isolates to PTY layer.\n",
                g_received, BURST_BYTES);
        return 2;
    }
    if (g_received < BURST_BYTES) {
        fprintf(stderr,
                "FAIL: short read (received %zu bytes; expected >= %u). "
                "Direct-exec producer dropped bytes mid-burst → ring "
                "backpressure regression independent of producer choice.\n",
                g_received, BURST_BYTES);
        return 3;
    }
    fprintf(stderr,
            "test_pty_burst_direct ok: received %zu bytes, marker observed "
            "(>= %u-byte payload + MARKER). If test_pty_burst FAIL on same "
            "run: powershell-startup IS the bottleneck.\n",
            g_received, BURST_BYTES);
    return 0;
}
