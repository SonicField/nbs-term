/*
 * p3_pty.phc — live PTY-driven terminal (cross-platform; P3 + P4)
 *
 * Strict pure-phc binary. Spawns a child via the pty.phc abstraction
 * (forkpty + execvp on POSIX, CreatePseudoConsole + CreateProcess on
 * Win32), wires the resulting PTYHandle into the Tcl event loop via
 * pty_install_tcl_handler, feeds incoming bytes through vt_parser into
 * the screen, renders via the same Tk canvas pattern as P2, sends
 * keypresses back to the child via pty_write, and propagates window
 * resizes via pty_resize (TIOCSWINSZ on POSIX, ResizePseudoConsole on
 * Win32).
 *
 * Binary name retains p3_ prefix for branch-history continuity; the
 * Win32 expansion (per supervisor 2026-05-01 12:39:05 P4 GO) lands here
 * via pty.phc rather than as a separate binary so alexie's smoke target
 * stays at one path.
 *
 * Build: make build/p3_pty && build/p3_pty               (local shell)
 *        build/p3_pty --ssh ssh user@host                 (live SSH)
 * Self-test: build/p3_pty -test                          (PTY + render + EOF)
 */
#if !defined(_WIN32)
#  ifndef _DEFAULT_SOURCE
#    define _DEFAULT_SOURCE 1
#  endif
#  ifndef _POSIX_C_SOURCE
#    define _POSIX_C_SOURCE 200809L
#  endif
#endif

#include <tcl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#if !defined(_WIN32)
#  include <unistd.h>
#  include <time.h>
#endif

#define phc_require(expr, msg) do { if (!(expr)) { \
    fprintf(stderr, "REQUIRE FAILED %s:%d: %s\n", __FILE__, __LINE__, msg); \
    abort(); }} while(0)
#define phc_check(expr, msg) do { if (!(expr)) { \
    fprintf(stderr, "CHECK FAILED %s:%d: %s\n", __FILE__, __LINE__, msg); \
    abort(); }} while(0)
#define phc_invariant(expr, msg) do { if (!(expr)) { \
    fprintf(stderr, "INVARIANT FAILED %s:%d: %s\n", __FILE__, __LINE__, msg); \
    abort(); }} while(0)
#define phc_free(pp) do { free(*(pp)); *(pp) = NULL; } while(0)

#include "vt_parser.phc"   /* pulls sgr.phc + screen.phc */
#include "pty.phc"          /* cross-platform PTY abstraction */
#include "config.phc"       /* nbs_config_load — honest-file at startup */
#include "render_color.phc" /* render_gamma — H gamma transform per
                             * theologian 14:43:30 + supervisor 14:43:37
                             * pre-stage (theologian 2308147 extract) */
#include "input.phc"       /* encode_key_event + encode_special_key +
                             * Modifier flags + SpecialKey enum — D
                             * special-keys port per theologian 15:47:17 */

/* Cell pixel grid — derived from TkFixedFont metrics at startup via
 * compute_cell_metrics() per feedback_tk_native_over_platform +
 * librarian D-1778048574 (no platform anchors; font.measure / font
 * metrics -linespace are the cross-platform Tk-native primitives).
 * Initial values are a safe fallback for the (vanishingly rare) case
 * where the font query fails before the first paint — every render
 * call after main()'s compute_cell_metrics uses the actual values. */
static int g_cell_w = 9;
static int g_cell_h = 16;

/* A2 layout state — origin-centering + slop padding per
 * theologian 15:54:45 mapping (legacy nbsterm.py:196-249
 * _compute_origin_for + alexie 2026-04-29 PADDING=4 halving).
 * Updated by compute_layout(); applied in render_screen +
 * render_cursor. Initial values are pre-paint fallbacks. */
#define NBS_PADDING 4
static int g_origin_x = NBS_PADDING;
static int g_origin_y = NBS_PADDING;

/* Globals so the Tcl file handler / command callbacks can find the engine
 * without ClientData plumbing for every registration. P5 will likely
 * pass a per-tab context via ClientData when multiple TerminalWidgets
 * coexist; for P3/P4 single-window scope, globals are honest. */
static Tcl_Interp        *g_interp = NULL;
static Terminal          *g_term   = NULL;
static VTParser          *g_parser = NULL;
static PTYHandle         *g_pty    = NULL;
static int                g_dirty = 0;        /* render scheduled flag */
static int                g_child_alive = 1;
static NbsTerminalConfig  g_config;           /* loaded by nbs_config_load in main() */

/* C cursor blink (per legacy nbsterm.py:441-443 + 514-525): toggles
 * g_blink_visible on a 530ms cadence when g_config.cursor.blink set;
 * any pty output resets the timer + forces visible (cursor stays
 * solid during active typing). render_cursor honors both this and
 * scr->mode_cursor_visible (DECTCEM, vt_parser.phc:240/256). */
#define NBS_BLINK_MS 530
static int             g_blink_visible = 1;
static Tcl_TimerToken  g_blink_after_id = NULL;

/* F selection state (stream selection from (sr,sc) to (er,ec) in
 * canonical lexicographic order — sel_normalise swaps if user
 * dragged backwards). g_sel_active gates render_screen's split-
 * paint + future copy. Coordinates are screen cells (after
 * pixel_to_cell), not pixels. */
static int g_sel_active = 0;
static int g_sel_sr = 0, g_sel_sc = 0;
static int g_sel_er = 0, g_sel_ec = 0;

/* Register the four named fonts the legacy nbs-term renderer expects
 * (font_normal / font_bold / font_italic / font_bold_italic), all
 * derived from TkFixedFont's family + size. Mirrors nbsterm.py:130-140
 * — same name => same span attribute coverage in render_screen.
 * Idempotent under repeated Tk_Init via 'font names' check (Tk forbids
 * re-creating an existing named font; this guard keeps p3_pty re-entry
 * safe even though current code creates the interp once). */
static void register_named_fonts(Tcl_Interp *interp) {
    /* Use g_config.font.{family,size} so the user's saved font (loaded
     * from ~/.nbs/nbs-term.honest by nbs_config_load() before this in
     * main()) takes effect at startup. Prior version derived from
     * TkFixedFont's family/size and IGNORED g_config — alexie 2026-05-13
     * 11:23:44: 'font size is not being applied at startup correctly.
     * Once started and Cmd^, is used - it picks it up' (because
     * nbs_open_prefs at p3_pty.phc:1305-1314 explicitly font configure'd
     * the named fonts to g_config values, masking the startup gap).
     * Defaults from nbs_config_default (config.phc:91-92) are
     * 'TkFixedFont' / size 14, so the cold-start path still resolves to
     * the prior behaviour when no config file exists. */
    /* Resolve g_config.font.family via [font actual {fam} -family]
     * BEFORE passing to font create. TkFixedFont (the cold-start
     * default per nbs_config_default config.phc:91) is a Tk
     * named-font alias not a real family — `font create -family
     * TkFixedFont -weight bold` resolves the alias for the family
     * but DROPS the -weight/-slant variants because Tk's family-
     * lookup chain doesn't propagate the modifier through the
     * alias. Result: font_bold = font_italic = font_normal in actual
     * rendering (alexie 2026-05-13 15:30:08 'Bold and italic do not
     * appear to work' + theologian 15:36:51 root cause). [font
     * actual] returns the resolved real family name (Menlo on
     * darwin / DejaVu on Linux / Courier New on Win); idempotent on
     * already-resolved families. Mirrors legacy nbsterm.py:55-63
     * default_font_family() pattern per memory feedback_legacy_port_
     * as_spec. */
    char fam[128];
    snprintf(fam, sizeof fam, "%s", g_config.font.family);
    char resolve_cmd[256];
    snprintf(resolve_cmd, sizeof resolve_cmd,
             "font actual {%s} -family", fam);
    if (Tcl_Eval(interp, resolve_cmd) == TCL_OK) {
        const char *r = Tcl_GetStringResult(interp);
        if (r && *r) snprintf(fam, sizeof fam, "%s", r);
    }
    char init[2048];
    snprintf(init, sizeof init,
        "if {[lsearch -exact [font names] font_normal] < 0} {"
        "  font create font_normal -family {%s} -size %d"
        "};"
        "if {[lsearch -exact [font names] font_bold] < 0} {"
        "  font create font_bold -family {%s} -size %d -weight bold"
        "};"
        "if {[lsearch -exact [font names] font_italic] < 0} {"
        "  font create font_italic -family {%s} -size %d -slant italic"
        "};"
        "if {[lsearch -exact [font names] font_bold_italic] < 0} {"
        "  font create font_bold_italic -family {%s} -size %d "
        "    -weight bold -slant italic"
        "}",
        fam, g_config.font.size,
        fam, g_config.font.size,
        fam, g_config.font.size,
        fam, g_config.font.size);
    Tcl_Eval(interp, init);
}

/* Query Tk for the actual font_normal character cell metrics so cursor
 * + glyph layout align across platforms. 'M' is conventional for
 * monospace cell width (font_normal inherits TkFixedFont, monospace,
 * so any printable ASCII gives the same answer; pick one explicitly
 * so the contract is obvious). 'font metrics -linespace' returns the
 * recommended inter-line vertical advance; matches the row spacing
 * used by '-anchor nw'-anchored text items. Tk requires Tk_Init +
 * register_named_fonts first; both run before this in main(). */
static void compute_cell_metrics(Tcl_Interp *interp) {
    if (Tcl_Eval(interp, "font measure font_normal M") == TCL_OK) {
        int w = atoi(Tcl_GetStringResult(interp));
        if (w > 0 && w <= 1000) g_cell_w = w;
    }
    if (Tcl_Eval(interp, "font metrics font_normal -linespace") == TCL_OK) {
        int h = atoi(Tcl_GetStringResult(interp));
        if (h > 0 && h <= 1000) g_cell_h = h;
    }
}

/* Map CellAttr Bold/Italic combination to the legacy Tk named-font
 * tag (matches nbsterm.py:131-140 _font_cache + extension.phc:988-991). */
static const char *attrs_to_font_tag(CellAttr attrs) {
    int bold   = (attrs & CellAttr_Bold)   != 0;
    int italic = (attrs & CellAttr_Italic) != 0;
    if (bold && italic) return "font_bold_italic";
    if (bold)           return "font_bold";
    if (italic)         return "font_italic";
    return "font_normal";
}

/* Forward decl — render_screen end-of-paint reflow may schedule
 * another idle render (A2 bbox-calibration / compute_layout convergence). */
static void schedule_render(void);

/* C cursor blink — toggles visibility, repaints, reschedules itself.
 * Cancelled (and re-armed visible) by on_pty_data on every PTY read,
 * so the cursor stays solid during active typing then resumes blink
 * 530ms after the last byte (matches legacy nbsterm.py:441-443). */
static void blink_proc(ClientData cd) {
    (void)cd;
    g_blink_after_id = NULL;
    if (!g_config.cursor.blink) return;
    g_blink_visible = !g_blink_visible;
    schedule_render();
    g_blink_after_id = Tcl_CreateTimerHandler(NBS_BLINK_MS, blink_proc, NULL);
}

/* Force cursor visible + reset the blink timer. Called from
 * on_pty_data after any received bytes so the user sees a solid
 * cursor while output is streaming. */
static void blink_reset(void) {
    g_blink_visible = 1;
    if (g_blink_after_id) {
        Tcl_DeleteTimerHandler(g_blink_after_id);
        g_blink_after_id = NULL;
    }
    if (g_config.cursor.blink) {
        g_blink_after_id = Tcl_CreateTimerHandler(NBS_BLINK_MS, blink_proc, NULL);
    }
}

/* Apply g_config.gamma to a #rrggbb hex color in-place via a caller-
 * provided buffer. Identity passthrough at gamma==1.0 (the loader
 * default; user-overridable in the honest file). Single funnel for
 * every color literal that hits the Tk canvas — uniform application
 * across canvas-widget -bg, per-cell bg, per-cell fg, cursor color,
 * and inverted-overlay text fg is what prevents the 59ed176 Bug C v3
 * 'cells lighter than slop' regression on Mac (gamma=1.2). */
static const char *gamma_apply(const char *hex, char *out, int outsz) {
    render_gamma(hex, g_config.gamma, out, outsz);
    return out;
}

/* Two cells share a render span iff fg, bg, and attrs all match.
 * Use color_equal (sgr.phc:123) — phc-generated Color_mk_Default
 * leaves the union body bytes uninitialised stack garbage (only the
 * tag is set), so memcmp on Color is unsafe across separate stack
 * frames: two Default colours can have matching tag + diverging
 * garbage bytes, breaking span-grouping on real shell output that
 * resets via SGR 39/49. color_equal phc_match-dispatches on tag and
 * compares only the variant-relevant fields. (Gatekeeper 15:22:14
 * BLOCK on 439c7cc.) */
static int cells_same_span(const Cell *a, const Cell *b) {
    if (a->attrs != b->attrs) return 0;
    if (!color_equal(a->fg, b->fg)) return 0;
    if (!color_equal(a->bg, b->bg)) return 0;
    return 1;
}

static int eval_argv(Tcl_Interp *interp, int objc, const char *argv[]) {
    Tcl_Obj **objv = (Tcl_Obj **)Tcl_Alloc(sizeof(Tcl_Obj *) * objc);
    for (int i = 0; i < objc; i++) {
        objv[i] = Tcl_NewStringObj(argv[i], -1);
        Tcl_IncrRefCount(objv[i]);
    }
    int rc = Tcl_EvalObjv(interp, objc, objv, 0);
    for (int i = 0; i < objc; i++) Tcl_DecrRefCount(objv[i]);
    Tcl_Free((char *)objv);
    return rc;
}
#define EVAL_ARGV(interp, argv) \
    eval_argv((interp), (int)(sizeof(argv) / sizeof((argv)[0])), (argv))

static int color_is_default(Color c) {
    int is_def = 0;
    phc_match(Color, c) {
        case Default: { is_def = 1; } break;
        case Indexed(index): { (void)index; is_def = 0; } break;
        case Rgb24(r, g, b): { (void)r; (void)g; (void)b; is_def = 0; } break;
    }
    return is_def;
}

static void color_to_hex(Color c, const char *defcol, char *out, int outsz) {
    phc_match(Color, c) {
        case Default: {
            snprintf(out, (size_t)outsz, "%s", defcol);
        } break;
        case Indexed(index): {
            static const char *ansi[] = {
                "#000000", "#cd0000", "#00cd00", "#cdcd00",
                "#0000ee", "#cd00cd", "#00cdcd", "#e5e5e5",
                "#7f7f7f", "#ff0000", "#00ff00", "#ffff00",
                "#5c5cff", "#ff00ff", "#00ffff", "#ffffff",
            };
            if (index < 16) {
                snprintf(out, (size_t)outsz, "%s", ansi[index]);
            } else if (index < 232) {
                int ci = index - 16;
                int r = ci / 36, g = (ci / 6) % 6, b = ci % 6;
                snprintf(out, (size_t)outsz, "#%02x%02x%02x",
                         r ? r * 40 + 55 : 0,
                         g ? g * 40 + 55 : 0,
                         b ? b * 40 + 55 : 0);
            } else {
                int v = (index - 232) * 10 + 8;
                snprintf(out, (size_t)outsz, "#%02x%02x%02x", v, v, v);
            }
        } break;
        case Rgb24(r, g, b): {
            snprintf(out, (size_t)outsz, "#%02x%02x%02x", r, g, b);
        } break;
    }
}

static int utf8_emit(uint32_t cp, char *buf, int bufsz) {
    if (cp < 0x80 && bufsz >= 1) { buf[0] = (char)cp; return 1; }
    if (cp < 0x800 && bufsz >= 2) {
        buf[0] = (char)(0xC0 | (cp >> 6));
        buf[1] = (char)(0x80 | (cp & 0x3F));
        return 2;
    }
    if (cp < 0x10000 && bufsz >= 3) {
        buf[0] = (char)(0xE0 | (cp >> 12));
        buf[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        buf[2] = (char)(0x80 | (cp & 0x3F));
        return 3;
    }
    if (bufsz >= 4) {
        buf[0] = (char)(0xF0 | (cp >> 18));
        buf[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
        buf[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
        buf[3] = (char)(0x80 | (cp & 0x3F));
        return 4;
    }
    return 0;
}

/* G — get the row of cells for the visible-window row r, compositing
 * scrollback + active screen when scroll_offset > 0 && !using_alt.
 * sb_idx = sb_count - scroll_offset + r:
 *   - in [0, sb_count) → scrollback line
 *   - in [sb_count, sb_count + scr->rows) → active screen row
 *   - else → NULL (out of bounds; caller treats as blank row)
 * Returns a pointer to scr->cols contiguous cells. Mirrors
 * extension.phc:881-912 composite-screen branch. */
static const Cell *view_row_cells(const Terminal *term, int r) {
    if (!term || !term->active) return NULL;
    const ScreenBuffer *scr = term->active;
    if (term->scroll_offset > 0 && !term->using_alt) {
        const Scrollback *sb = term->scrollback;
        int sb_idx = sb->count - term->scroll_offset + r;
        if (sb_idx >= 0 && sb_idx < sb->count) {
            return scrollback_get(sb, sb_idx);
        }
        if (sb_idx >= sb->count) {
            int sr = sb_idx - sb->count;
            if (sr >= 0 && sr < scr->rows) return &scr->cells[sr * scr->cols];
        }
        return NULL;
    }
    if (r < 0 || r >= scr->rows) return NULL;
    return &scr->cells[r * scr->cols];
}

/* G — bounds-clamp + dirty-mark wrappers for scroll_offset; mirrors
 * extension.phc:1207-1237 Terminal_set_scroll_offset +
 * Terminal_scroll_lines verbatim minus the Python plumbing.
 * scroll_lines convention: positive delta = scroll into history. */
static void nbs_set_scroll_offset(Terminal *term, int offset) {
    if (!term || !term->scrollback || !term->active) return;
    int max_off = term->scrollback->count;
    if (offset < 0)        offset = 0;
    if (offset > max_off)  offset = max_off;
    if (offset != term->scroll_offset) {
        term->scroll_offset = offset;
        memset(term->active->dirty, 1, (size_t)term->active->rows);
    }
}

static void nbs_scroll_lines_apply(Terminal *term, int delta) {
    if (!term) return;
    nbs_set_scroll_offset(term, term->scroll_offset + delta);
}

/* F — UTF-8 byte offset of the char_idx-th codepoint within text.
 * Mirrors extension.phc:819 utf8_byte_offset; used by flush_span's
 * selection split to slice span_text by cell index. */
static int utf8_byte_offset(const char *text, int byte_len, int char_idx) {
    int ci = 0, i = 0;
    while (i < byte_len && ci < char_idx) {
        unsigned char c = (unsigned char)text[i];
        if      (c < 0x80) i += 1;
        else if (c < 0xE0) i += 2;
        else if (c < 0xF0) i += 3;
        else               i += 4;
        ci++;
    }
    return i;
}

/* F — normalise stream selection to canonical (sr,sc) <= (er,ec)
 * order. g_sel_* are mutated for forward-walk semantics in copy +
 * row_sel_range. Returns 1 if swapped, 0 otherwise. */
static int sel_normalise(int *sr, int *sc, int *er, int *ec) {
    if (*sr > *er || (*sr == *er && *sc > *ec)) {
        int tr = *sr, tc = *sc;
        *sr = *er; *sc = *ec;
        *er = tr; *ec = tc;
        return 1;
    }
    return 0;
}

/* F — mouse pixel -> cell (row, col), uniform-divide fallback.
 * Uniform divide by g_cell_w/h with origin offset; clamps to active
 * screen bounds. Used by pixel_to_cell_text_aware as the cold-start
 * fallback when no rendered row data is available (no g_term, empty
 * row, or measurement Tcl_Eval failure). */
static void pixel_to_cell(int px, int py, int *r, int *c) {
    int x = px - g_origin_x;
    int y = py - g_origin_y;
    int cc = (x < 0) ? 0 : x / g_cell_w;
    int rr = (y < 0) ? 0 : y / g_cell_h;
    if (g_term && g_term->active) {
        if (cc >= g_term->active->cols) cc = g_term->active->cols - 1;
        if (rr >= g_term->active->rows) rr = g_term->active->rows - 1;
        if (cc < 0) cc = 0;
        if (rr < 0) rr = 0;
    }
    *c = cc;
    *r = rr;
}

/* F — text-aware mouse pixel -> cell. Walks the row's spans the same
 * way render_screen does (cells_same_span boundary), measures each
 * span via Tk's `font measure <font_tag> <text>`, and binary-searches
 * the prefix of the target span to map local_x to a codepoint index;
 * the codepoint index maps back to a cell column via a per-codepoint
 * cell lookup table built during the walk (handles wide chars: each
 * non-wide_cont cell contributes one codepoint, wide_cont cells are
 * skipped from the codepoint sequence per render_screen).
 *
 * Mirrors nbsterm.py:286-337 _pixel_to_cell_text_aware (per memory
 * feedback_legacy_port_as_spec). Bug A axis: uniform-divide breaks
 * on Mac where CoreText subadditivity makes
 * font.measure(c*N) != N * font.measure(c); per-span walk handles
 * subadditivity uniformly via Tk's generic font.measure (per memory
 * feedback_tk_native_over_platform — no Mac special-case).
 *
 * Cold-start fallback: uniform pixel_to_cell when the row is absent
 * (NULL view_row) or when `font measure` Tcl_Eval fails. */
static void pixel_to_cell_text_aware(Tcl_Interp *interp, int px, int py,
                                     int *r, int *c) {
    int y = py - g_origin_y;
    int rr = (y < 0) ? 0 : y / g_cell_h;
    if (!g_term || !g_term->active) {
        pixel_to_cell(px, py, r, c);
        return;
    }
    int cols = g_term->active->cols;
    int rows = g_term->active->rows;
    if (rr >= rows) rr = rows - 1;
    if (rr < 0)     rr = 0;
    *r = rr;

    const Cell *view_row = view_row_cells(g_term, rr);
    if (!view_row) {
        int x = px - g_origin_x;
        int cc = (x < 0) ? 0 : x / g_cell_w;
        if (cc >= cols) cc = cols - 1;
        if (cc < 0)     cc = 0;
        *c = cc;
        return;
    }

    int cur_x = g_origin_x;
    int span_active = 0;
    Cell span_proto;
    memset(&span_proto, 0, sizeof span_proto);
    char span_text[4096];
    int  span_text_len = 0;
    int  span_codepoints = 0;
    /* span_cell_at_cp[i] = cell column of i-th codepoint in current
     * span; lets binary-search result (codepoint index) map back to
     * cell column even when wide chars make codepoint != cell offset. */
    int  span_cell_at_cp[1024];

    /* Walk cc=[0..cols] inclusive — final iteration cc==cols flushes
     * the trailing in-flight span (mirrors render_screen end-of-row
     * flush at line 997-1004). */
    for (int cc = 0; cc <= cols; cc++) {
        const Cell *cell = (cc < cols) ? &view_row[cc] : NULL;
        int boundary = (cc == cols) || !span_active ||
                       (cell && !cells_same_span(&span_proto, cell));
        if (boundary && span_active && span_text_len > 0) {
            span_text[span_text_len] = '\0';
            const char *font_tag = attrs_to_font_tag(span_proto.attrs);
            const char *measure[] = {"font", "measure", font_tag, span_text};
            int span_w = 0;
            if (EVAL_ARGV(interp, measure) != TCL_OK) {
                /* Measurement failed — fall back to uniform on this row. */
                pixel_to_cell(px, py, r, c);
                return;
            }
            span_w = atoi(Tcl_GetStringResult(interp));
            if (px < cur_x + span_w) {
                int local_x = px - cur_x;
                if (local_x < 0) local_x = 0;
                /* Binary search smallest i s.t. measure(text[:i+1]) > local_x.
                 * Mirrors nbsterm.py:273-284 _binary_search_char. */
                int lo = 0, hi = span_codepoints;
                while (lo < hi) {
                    int mid = (lo + hi) / 2;
                    int byte_off = utf8_byte_offset(span_text, span_text_len,
                                                    mid + 1);
                    char saved = span_text[byte_off];
                    span_text[byte_off] = '\0';
                    const char *m2[] = {"font", "measure", font_tag, span_text};
                    int prefix_w = 0;
                    int ok = (EVAL_ARGV(interp, m2) == TCL_OK);
                    if (ok) prefix_w = atoi(Tcl_GetStringResult(interp));
                    span_text[byte_off] = saved;
                    if (!ok) {
                        pixel_to_cell(px, py, r, c);
                        return;
                    }
                    if (local_x < prefix_w) hi = mid;
                    else                    lo = mid + 1;
                }
                int col;
                if (lo >= span_codepoints) {
                    /* Past span's right edge — return the last cell of
                     * the span (cc-1 = the cell just before the next-span
                     * boundary or end-of-row sentinel). */
                    col = cc - 1;
                } else {
                    col = span_cell_at_cp[lo];
                }
                if (col < 0)     col = 0;
                if (col >= cols) col = cols - 1;
                *c = col;
                return;
            }
            cur_x += span_w;
            span_text_len = 0;
            span_codepoints = 0;
        }
        if (cc == cols) break;
        if (cell->wide_cont) continue;
        if (boundary) {
            span_active = 1;
            span_proto = *cell;
        }
        if (span_codepoints <
            (int)(sizeof span_cell_at_cp / sizeof span_cell_at_cp[0])) {
            span_cell_at_cp[span_codepoints] = cc;
        }
        uint32_t cp = cell->codepoint ? cell->codepoint : ' ';
        if (span_text_len + 4 < (int)sizeof span_text) {
            span_text_len += utf8_emit(cp, span_text + span_text_len,
                                       (int)sizeof span_text - span_text_len);
            span_codepoints++;
        }
    }

    /* Fell off the right edge of all spans — return last column. */
    *c = cols - 1;
}

/* F — per-row selection cell range under the canonical (sr,sc)<=(er,ec)
 * stream-selection model. Sets *out_c0 / *out_c1 = -1 when no cells on
 * row r are selected. */
static void row_sel_range(int r, int sr, int sc, int er, int ec, int cols,
                          int *out_c0, int *out_c1) {
    if (r < sr || r > er) { *out_c0 = -1; *out_c1 = -1; return; }
    int c0 = (r == sr) ? sc : 0;
    int c1 = (r == er) ? ec : cols;
    if (c1 <= c0) { *out_c0 = -1; *out_c1 = -1; return; }
    *out_c0 = c0;
    *out_c1 = c1;
}

/* A2 — origin centering per nbsterm.py:196-249. Builds the same
 * per-row codepoint sequence render_screen will paint, runs Tk
 * font measure on each row to find the widest, then centers the
 * text block in the canvas with a 2*g_cell_w slop cap on the
 * horizontal margin (alexie 2026-04-29 17:56:52 'slop too wide'
 * bound; d390acc + librarian D-1777362486-confirmed pattern;
 * theologian_branch_tree_bug_c.md trap — must NOT shrink to
 * char_width//8 of 60a1291). PADDING fallback when no text
 * (cold-start). Returns 1 if g_origin_x or g_origin_y changed. */
static int compute_layout(Tcl_Interp *interp, const ScreenBuffer *scr) {
    int canvas_w = 0, canvas_h = 0;
    if (Tcl_Eval(interp, "winfo width .c") == TCL_OK) {
        canvas_w = atoi(Tcl_GetStringResult(interp));
    }
    if (Tcl_Eval(interp, "winfo height .c") == TCL_OK) {
        canvas_h = atoi(Tcl_GetStringResult(interp));
    }
    /* Walk every row, build the same codepoint sequence render_screen
     * builds, measure under font_normal, take the max — gives the
     * actual painted text width regardless of per-cell-width drift
     * on platforms where font.measure(M) under-counts. */
    int max_w = 0;
    char rowbuf[4096];
    /* G — measure the COMPOSITE view (scrollback + screen) so layout
     * stays consistent when scrolled back. view_row_cells returns the
     * scrollback-sourced row when applicable. */
    for (int r = 0; r < scr->rows; r++) {
        int rowlen = 0;
        const Cell *row = view_row_cells(g_term, r);
        for (int c = 0; c < scr->cols && rowlen < (int)sizeof rowbuf - 4; c++) {
            const Cell *cell = row ? &row[c] : NULL;
            if (!cell) {
                rowlen += utf8_emit(' ', rowbuf + rowlen,
                                    (int)sizeof rowbuf - rowlen);
                continue;
            }
            if (cell->wide_cont) continue;
            uint32_t cp = cell->codepoint ? cell->codepoint : ' ';
            rowlen += utf8_emit(cp, rowbuf + rowlen,
                                (int)sizeof rowbuf - rowlen);
        }
        rowbuf[rowlen] = '\0';
        if (rowlen == 0) continue;
        const char *measure[] = {"font", "measure", "font_normal", rowbuf};
        if (EVAL_ARGV(interp, measure) == TCL_OK) {
            int w = atoi(Tcl_GetStringResult(interp));
            if (w > max_w) max_w = w;
        }
    }
    int new_x, new_y;
    if (max_w == 0 || canvas_w == 0 || canvas_h == 0) {
        new_x = NBS_PADDING;
        new_y = NBS_PADDING;
    } else {
        /* Centering with UNCONDITIONAL 2*g_cell_w cap on horizontal
         * margin per legacy nbsterm.py:236
         *     origin_x = min((canvas_w - text_w) // 2, 2 * char_width)
         * Prior conditional cap (only when max_w < canvas_w/2) per
         * supervisor 2026-05-13 15:36:28 + theologian 14:50:39
         * option (iii) was supposed to keep dense rows full-centered,
         * but alexie 2026-05-14 07:44:39 reports 'borders at the
         * sides of the screen are still several characters wide' on
         * Mac with that conditional. Port the legacy unconditional
         * shape directly per [[feedback_legacy_port_as_spec]] +
         * alexie's reference 'wide border issue ... you fixed it
         * there so I am sure you can fix it here too'. */
        new_x = (canvas_w - max_w) / 2;
        int cap = 2 * g_cell_w;
        if (new_x > cap) new_x = cap;
        if (new_x < 0) new_x = 0;
        int text_h = scr->rows * g_cell_h;
        new_y = (canvas_h - text_h) / 2;
        if (new_y < 0) new_y = 0;
    }
    int changed = (new_x != g_origin_x) || (new_y != g_origin_y);
    g_origin_x = new_x;
    g_origin_y = new_y;
    return changed;
}

/* A2 — bbox-calibration per nbsterm.py:497-512. After a paint,
 * query the canvas bbox of the row0 text item, divide by cols to
 * get the actual rendered cell width, and WIDEN g_cell_w if it
 * exceeds the current value by >0.5px. Asymmetric (never shrink):
 * Win 'monospace' alias on some installs is not actually fixed
 * width — without WIDEN-only, the cell-width oscillates and
 * line-wrap breaks (alexie 2026-04-28 14:23:15 cols-runaway).
 * Returns 1 if g_cell_w changed. */
static int bbox_calibrate(Tcl_Interp *interp, const ScreenBuffer *scr) {
    if (scr->cols < 1) return 0;
    if (Tcl_Eval(interp, ".c bbox row0") != TCL_OK) return 0;
    Tcl_Obj *res = Tcl_GetObjResult(interp);
    Tcl_Obj **bbox_elts = NULL;
    int bbox_n = 0;
    if (Tcl_ListObjGetElements(interp, res, &bbox_n, &bbox_elts) != TCL_OK) return 0;
    if (bbox_n != 4) return 0;  /* empty row -> empty bbox -> no calibration */
    int x1 = 0, x2 = 0;
    if (Tcl_GetIntFromObj(interp, bbox_elts[0], &x1) != TCL_OK) return 0;
    if (Tcl_GetIntFromObj(interp, bbox_elts[2], &x2) != TCL_OK) return 0;
    int eff = (x2 - x1) / scr->cols;
    if (eff > g_cell_w) {
        g_cell_w = eff;
        return 1;
    }
    return 0;
}

/* Cursor overlay — legacy 'inline cursor system' port per alexie
 * 2026-05-12 13:39:01 + theologian 13:41:40 mapping. Mirrors
 * extension.phc:1109-1152 (= nbsterm.py:368-407 from 07e0158
 * 'Cursor overlay no span split'); takes pixel x from
 * font.measure(<row prefix bytes up to cursor col>) so the block
 * lands ON the painted glyph regardless of TkFixedFont's actual
 * per-platform width (uniform col*g_cell_w grid drifts on Win
 * where the resolved monospace face is wider than 9px).
 *
 * Style branch (g_config.cursor.style):
 *  - Block: full cell rect in cursor color + re-render the cell
 *    character on top in g_config.bg (inverted-overlay; without
 *    this the block obscures the glyph it should be highlighting)
 *  - Underline: 2px rect at bottom of cell
 *  - Bar: 2px wide rect at left of cell
 *
 * Always-visible — screen.phc has no DECTCEM hide-cursor mode yet.
 * Tagged "cursor" so `delete all` at the top of render_screen
 * collects the previous frame's overlay in one pass. */
static int render_cursor(Tcl_Interp *interp, const char *canvas,
                         const ScreenBuffer *scr) {
    /* C — DECTCEM gate (vt_parser.phc:240/256 toggles
     * mode_cursor_visible; default 1). Plus blink gate: when
     * g_config.cursor.blink set, blink_proc toggles g_blink_visible
     * on a 530ms cadence; on_pty_data forces g_blink_visible=1 +
     * resets the timer for the active-typing-stays-solid behaviour. */
    if (!scr->mode_cursor_visible) return TCL_OK;
    if (g_config.cursor.blink && !g_blink_visible) return TCL_OK;
    /* G — hide cursor when scrolled back into history; the cursor
     * lives at a screen-cell coordinate that may not be visible in
     * the composite view. Painting it would mark the wrong cell. */
    if (g_term && g_term->scroll_offset > 0 && !g_term->using_alt) return TCL_OK;

    int r = scr->cursor.row;
    int c = scr->cursor.col;
    if (r < 0) r = 0;
    if (r >= scr->rows) r = scr->rows - 1;
    if (c < 0) c = 0;
    if (c >= scr->cols) c = scr->cols - 1;

    /* Build the row prefix (visible cells only, skipping wide_cont
     * the same way render_screen does) up to the cursor column.
     * This is the byte sequence Tk has actually painted to the left
     * of the cursor cell — feeding it through 'font measure' gives
     * the exact pixel x where the cursor glyph starts. */
    /* G — cursor lives on the live screen; scroll_offset==0 here per
     * the early-return above. screen_cell_const is correct. */
    char prefix[4096];
    int  prefixlen = 0;
    for (int cc = 0; cc < c && prefixlen < (int)sizeof prefix - 4; cc++) {
        const Cell *cell = screen_cell_const(scr, r, cc);
        if (cell->wide_cont) continue;
        uint32_t cp = cell->codepoint ? cell->codepoint : ' ';
        prefixlen += utf8_emit(cp, prefix + prefixlen,
                               (int)sizeof prefix - prefixlen);
    }
    prefix[prefixlen] = '\0';

    int cx = 0;
    {
        const char *measure[] = {"font", "measure", "font_normal", prefix};
        if (EVAL_ARGV(interp, measure) == TCL_OK) {
            cx = atoi(Tcl_GetStringResult(interp));
        }
    }
    /* A2 origin offset — keeps the cursor block on the painted glyph
     * after compute_layout shifts the row text away from x=0. */
    cx += g_origin_x;
    int cy = g_origin_y + r * g_cell_h;

    /* H gamma applied to both the cursor block fill and the inverted-
     * overlay text fg (which is g_config.bg). Same uniform-gamma
     * principle as flush_span/canvas widget — without it the cursor
     * surface drifts off the gammaed cell beneath it. */
    char cur_color_g[16], inv_text_g[16];
    const char *cur_raw = g_config.cursor.color[0]
                            ? g_config.cursor.color
                            : g_config.fg;
    const char *cur_color = gamma_apply(cur_raw, cur_color_g, sizeof cur_color_g);
    const char *inv_text  = gamma_apply(g_config.bg, inv_text_g, sizeof inv_text_g);

    char xs[16], ys[16], x2s[16], y2s[16];

    /* Underline / Bar: simple thin-rect overlays, no character re-render
     * (the row text item already painted the glyph and the overlay sits
     * at the cell edge, not on top). */
    if (strcmp(g_config.cursor.style, "Underline") == 0) {
        snprintf(xs,  sizeof xs,  "%d", cx);
        snprintf(ys,  sizeof ys,  "%d", cy + g_cell_h - 2);
        snprintf(x2s, sizeof x2s, "%d", cx + g_cell_w);
        snprintf(y2s, sizeof y2s, "%d", cy + g_cell_h);
        const char *rect[] = {canvas, "create", "rectangle",
                              xs, ys, x2s, y2s,
                              "-fill", cur_color, "-outline", "",
                              "-tags", "cursor"};
        return EVAL_ARGV(interp, rect);
    }
    if (strcmp(g_config.cursor.style, "Bar") == 0) {
        snprintf(xs,  sizeof xs,  "%d", cx);
        snprintf(ys,  sizeof ys,  "%d", cy);
        snprintf(x2s, sizeof x2s, "%d", cx + 2);
        snprintf(y2s, sizeof y2s, "%d", cy + g_cell_h);
        const char *rect[] = {canvas, "create", "rectangle",
                              xs, ys, x2s, y2s,
                              "-fill", cur_color, "-outline", "",
                              "-tags", "cursor"};
        return EVAL_ARGV(interp, rect);
    }

    /* Block (default): rect + inverted-overlay character. The text
     * item painted on top uses g_config.bg as fg so the cursor cell
     * character remains visible inside the cursor block. */
    snprintf(xs,  sizeof xs,  "%d", cx);
    snprintf(ys,  sizeof ys,  "%d", cy);
    snprintf(x2s, sizeof x2s, "%d", cx + g_cell_w);
    snprintf(y2s, sizeof y2s, "%d", cy + g_cell_h);
    const char *rect[] = {canvas, "create", "rectangle",
                          xs, ys, x2s, y2s,
                          "-fill", cur_color, "-outline", "",
                          "-tags", "cursor"};
    if (EVAL_ARGV(interp, rect) != TCL_OK) return TCL_ERROR;

    const Cell *cur_cell = screen_cell_const(scr, r, c);
    uint32_t cp = cur_cell->codepoint ? cur_cell->codepoint : ' ';
    char ch[8];
    int ch_len = utf8_emit(cp, ch, (int)sizeof ch - 1);
    ch[ch_len] = '\0';
    const char *text[] = {canvas, "create", "text",
                          xs, ys,
                          "-anchor", "nw", "-text", ch,
                          "-fill", inv_text, "-font", "font_normal",
                          "-tags", "cursor"};
    return EVAL_ARGV(interp, text);
}

/* Emit one sub-span (pre / sel / post slice of a span, or the full
 * span when no selection overlap). bg rect when force_bg is set OR
 * non-default; text with the given fill + font_tag. Returns the
 * pixel width consumed via *out_w so caller can advance x. */
static int emit_sub(Tcl_Interp *interp, const char *canvas,
                    int r, int sub_start_col, int x_pixel, int y_pixel,
                    const char *sub_text, int sub_text_len,
                    const char *fg_fill, const char *bg_fill,
                    int force_bg, const char *font_tag, int *out_w) {
    int sub_w = 0;
    {
        const char *measure[] = {"font", "measure", font_tag, sub_text};
        if (EVAL_ARGV(interp, measure) == TCL_OK) {
            sub_w = atoi(Tcl_GetStringResult(interp));
        }
    }
    if (sub_w <= 0) sub_w = sub_text_len * g_cell_w;
    char xs[16], ys[16], x2s[16], y2s[16], tag[32];
    snprintf(xs,  sizeof xs,  "%d", x_pixel);
    snprintf(ys,  sizeof ys,  "%d", y_pixel);
    if (force_bg) {
        snprintf(x2s, sizeof x2s, "%d", x_pixel + sub_w);
        snprintf(y2s, sizeof y2s, "%d", y_pixel + g_cell_h);
        snprintf(tag, sizeof tag, "bg%d_%d", r, sub_start_col);
        const char *rect[] = {canvas, "create", "rectangle",
                              xs, ys, x2s, y2s,
                              "-fill", bg_fill, "-outline", "",
                              "-tags", tag};
        if (EVAL_ARGV(interp, rect) != TCL_OK) return TCL_ERROR;
    }
    char tags_buf[64];
    snprintf(tags_buf, sizeof tags_buf, "row%d row%d_%d",
             r, r, sub_start_col);
    const char *text[] = {canvas, "create", "text",
                          xs, ys,
                          "-anchor", "nw", "-text", sub_text,
                          "-fill", fg_fill, "-font", font_tag,
                          "-tags", tags_buf};
    if (EVAL_ARGV(interp, text) != TCL_OK) return TCL_ERROR;
    *out_w = sub_w;
    return TCL_OK;
}

/* Emit one render span — split into pre/sel/post sub-spans when
 * g_sel_active and the selection range [sel_c0, sel_c1) overlaps
 * the span's cell range [span_start_col, span_end_col). Sel sub-
 * span uses fg/bg-swapped colours (matching extension.phc:1083-1088
 * legacy paint). Mirrors extension.phc:1006-1107 selection-aware
 * branch + 1041-1047 no-selection fallback. */
static int flush_span(Tcl_Interp *interp, const char *canvas,
                      int r, int span_start_col, int span_end_col,
                      int sel_c0, int sel_c1,
                      int y_pixel, const char *span_text,
                      Color fg, Color bg, CellAttr attrs,
                      int *x_inout) {
    /* Resolve colours BEFORE gamma + dim + inverse swap. Mirrors
     * legacy extension.phc:970-985 order: color_to_hex (with each
     * side's correct defcol — g_config.fg for fg, g_config.bg for
     * bg) → gamma → dim (fg only) → inverse swap of resolved hex.
     *
     * Prior pure-phc shape swapped Color tags FIRST then resolved
     * with fixed defcols (g_config.fg for fg-side, g_config.bg for
     * bg-side). When both fg + bg arrived as Default + Inverse set,
     * post-swap fg was Default-tagged → resolved to g_config.fg via
     * its defcol; same for bg → g_config.bg. Identical resolution
     * to no-Inverse path; visual no-op. claude-code emits SGR 7 for
     * its own cursor cell with neither fg nor bg explicitly set
     * (Default+Default+Inverse) → cursor cell rendered identical to
     * surrounding text → INVISIBLE (alexie 2026-05-13 14:16:47 +
     * theologian 13:56:44 root cause). Resolve-then-swap-resolved-
     * hex makes the inversion always visible regardless of which
     * side carried Default. */
    char fg_hex[16], bg_hex[16], fg_g[16], bg_g[16];
    color_to_hex(fg, g_config.fg, fg_hex, sizeof fg_hex);
    color_to_hex(bg, g_config.bg, bg_hex, sizeof bg_hex);
    /* H gamma per supervisor 14:43:37 — apply uniformly to fg + bg
     * (companion canvas-widget -bg gamma at main(); cursor-side gamma
     * inside render_cursor). */
    gamma_apply(fg_hex, fg_g, sizeof fg_g);
    gamma_apply(bg_hex, bg_g, sizeof bg_g);
    /* DIM (SGR 2): halve fg channels post-gamma per legacy
     * extension.phc:977-980. Fix wires CellAttr_Dim — bit was
     * parsed in sgr.phc but ignored at render time (alexie 2026-
     * 05-13 14:16:47 'dimmed text rendered as the same as normal
     * brightness' + theologian 14:18:00 root cause). */
    if (attrs & CellAttr_Dim) {
        char fg_dim[16];
        render_dim(fg_g, fg_dim, sizeof fg_dim);
        snprintf(fg_g, sizeof fg_g, "%s", fg_dim);
    }
    /* INVERSE (SGR 7): swap RESOLVED fg/bg hex post-gamma + post-dim
     * per legacy extension.phc:981-985. Doing the swap on resolved
     * hex (not Color objects) ensures Default+Default gives a
     * visible inversion: fg_g=g_config.fg, bg_g=g_config.bg pre-
     * swap → fg_g=g_config.bg, bg_g=g_config.fg post-swap. */
    if (attrs & CellAttr_Inverse) {
        char tmp[16];
        snprintf(tmp,  sizeof tmp,  "%s", fg_g);
        snprintf(fg_g, sizeof fg_g, "%s", bg_g);
        snprintf(bg_g, sizeof bg_g, "%s", tmp);
    }
    const char *fg_render = fg_g;
    const char *bg_render = bg_g;

    const char *font_tag = attrs_to_font_tag(attrs);
    int bg_default = color_is_default(bg) && !(attrs & CellAttr_Inverse);

    int span_count = span_end_col - span_start_col;
    int span_text_len = (int)strlen(span_text);
    int x_pixel = *x_inout;

    /* Compute selection-overlap window in span-local cell coords. */
    int sub_start = -1, sub_end = -1;
    if (sel_c0 >= 0 && sel_c1 > span_start_col && sel_c0 < span_end_col) {
        sub_start = (sel_c0 > span_start_col) ? sel_c0 - span_start_col : 0;
        sub_end   = (sel_c1 < span_end_col)   ? sel_c1 - span_start_col : span_count;
    }

    if (sub_start < 0) {
        /* No selection overlap — single sub-span paint. */
        int sub_w = 0;
        if (emit_sub(interp, canvas, r, span_start_col, x_pixel, y_pixel,
                     span_text, span_text_len,
                     fg_render, bg_render, !bg_default,
                     font_tag, &sub_w) != TCL_OK) return TCL_ERROR;
        *x_inout = x_pixel + sub_w;
        return TCL_OK;
    }

    /* Split into up to 3 sub-spans: pre / sel / post. Selected sub-
     * span paints with swapped colours (fg becomes bg-fill, bg-or-
     * default-fg becomes text-fill — extension.phc:1083-1088). */
    char sub_text[4096];
    int  bx = x_pixel;

    if (sub_start > 0) {
        int b_bytes = utf8_byte_offset(span_text, span_text_len, sub_start);
        if (b_bytes > (int)sizeof sub_text - 1) b_bytes = (int)sizeof sub_text - 1;
        memcpy(sub_text, span_text, (size_t)b_bytes);
        sub_text[b_bytes] = '\0';
        int sub_w = 0;
        if (emit_sub(interp, canvas, r, span_start_col, bx, y_pixel,
                     sub_text, b_bytes,
                     fg_render, bg_render, !bg_default,
                     font_tag, &sub_w) != TCL_OK) return TCL_ERROR;
        bx += sub_w;
    }

    {
        int s_byte_start = utf8_byte_offset(span_text, span_text_len, sub_start);
        int s_byte_end   = utf8_byte_offset(span_text, span_text_len, sub_end);
        int s_bytes = s_byte_end - s_byte_start;
        if (s_bytes < 0) s_bytes = 0;
        if (s_bytes > (int)sizeof sub_text - 1) s_bytes = (int)sizeof sub_text - 1;
        memcpy(sub_text, span_text + s_byte_start, (size_t)s_bytes);
        sub_text[s_bytes] = '\0';
        int sub_w = 0;
        /* Selected sub-span: fg colour becomes the rect fill, bg
         * colour becomes the text fill — visual highlight matches
         * legacy nbsterm split-render. */
        if (emit_sub(interp, canvas, r, span_start_col + sub_start, bx, y_pixel,
                     sub_text, s_bytes,
                     bg_render, fg_render, 1 /* always paint sel rect */,
                     font_tag, &sub_w) != TCL_OK) return TCL_ERROR;
        bx += sub_w;
    }

    if (sub_end < span_count) {
        int a_byte_start = utf8_byte_offset(span_text, span_text_len, sub_end);
        int a_bytes = span_text_len - a_byte_start;
        if (a_bytes < 0) a_bytes = 0;
        if (a_bytes > (int)sizeof sub_text - 1) a_bytes = (int)sizeof sub_text - 1;
        memcpy(sub_text, span_text + a_byte_start, (size_t)a_bytes);
        sub_text[a_bytes] = '\0';
        int sub_w = 0;
        if (emit_sub(interp, canvas, r, span_start_col + sub_end, bx, y_pixel,
                     sub_text, a_bytes,
                     fg_render, bg_render, !bg_default,
                     font_tag, &sub_w) != TCL_OK) return TCL_ERROR;
        bx += sub_w;
    }

    *x_inout = bx;
    return TCL_OK;
}

/* Per-row span walker: groups consecutive cells with identical
 * (fg, bg, attrs) into one Tk text item; ports
 * extension.phc:925-1156 row-loop minus the
 * scrollback / dirty-region / selection-split / cursor-overlay
 * branches (latter handled by render_cursor). */
static int render_screen(Tcl_Interp *interp, const char *canvas,
                         const Terminal *term) {
    const ScreenBuffer *scr = term->active;
    const char *clear[] = {canvas, "delete", "all"};
    if (EVAL_ARGV(interp, clear) != TCL_OK) return TCL_ERROR;

    /* P bg_fill — paint the WHOLE canvas with the gamma-corrected bg
     * before any text / per-cell-rect items, so margins (uncovered
     * widget-bg pixels left/right of the centered text block) render
     * uniform with the text area. Hides the cap-at-2*g_cell_w origin-x
     * asymmetry that exposes Mac aqua-tinted widget surface; on Linux/
     * Win the change is a no-op visually (widget -bg already paints
     * uniform). Pure-Tk canvas create_rectangle, no platform-specific
     * code per memory feedback_tk_native_over_platform. Mirrors legacy
     * nbsterm.py:474-478 (commit 5feed64 Bug C v3 + 4dcfc94 integration)
     * per memory feedback_legacy_port_as_spec. alexie 2026-05-13
     * 11:27:24 #2 + theologian 11:31:18 root cause + fix shape.
     *
     * Option A WIN-RESILIENCE (theologian 2026-05-13 12:21:57 + testkeeper
     * 12:22:22 reframe + supervisor 12:23:10 pivot): take MAX of winfo +
     * cget canvas dims. winfo width/height returns 1 pre-Map AND can
     * partially-resolve mid-frame on Win (CI 25798304505 caught
     * winfo=1028 inside same render_screen call where compute_layout saw
     * winfo>1200). cget -width/-height was set explicitly at canvas-
     * create time (main():1660 = cols*cell_w x rows*cell_h) so it is a
     * known-correct floor pre-Map AND across the multi-cycle Win refresh
     * window. Ceiling tracks resize-grow via winfo. Result: bg_fill is
     * decoupled from Win Tk geometry-resolution timing. */
    char bg_hex[16];
    gamma_apply(g_config.bg, bg_hex, sizeof bg_hex);
    char dims_query[160];
    snprintf(dims_query, sizeof dims_query,
        "list [winfo width %s] [winfo height %s] "
        "[%s cget -width] [%s cget -height]",
        canvas, canvas, canvas, canvas);
    int wfw = 0, wfh = 0, cgw = 0, cgh = 0;
    if (Tcl_Eval(interp, dims_query) == TCL_OK) {
        sscanf(Tcl_GetStringResult(interp), "%d %d %d %d",
               &wfw, &wfh, &cgw, &cgh);
    }
    int bg_w = (wfw > cgw) ? wfw : cgw;
    int bg_h = (wfh > cgh) ? wfh : cgh;
    char bg_fill_cmd[256];
    snprintf(bg_fill_cmd, sizeof bg_fill_cmd,
        "%s create rectangle 0 0 %d %d "
        "-fill %s -outline {} -tags bg_fill",
        canvas, bg_w, bg_h, bg_hex);
    if (Tcl_Eval(interp, bg_fill_cmd) != TCL_OK) return TCL_ERROR;

    /* F — normalise selection once per render so flush_span sees a
     * canonical (sr,sc)<=(er,ec) range. Reverse-drag handled here. */
    int sel_sr = g_sel_sr, sel_sc = g_sel_sc;
    int sel_er = g_sel_er, sel_ec = g_sel_ec;
    if (g_sel_active) sel_normalise(&sel_sr, &sel_sc, &sel_er, &sel_ec);

    for (int r = 0; r < scr->rows; r++) {
        /* A2 — paint each row at the centered origin per
         * compute_layout (NBS_PADDING fallback before first paint). */
        int x_pixel = g_origin_x;
        int y_pixel = g_origin_y + r * g_cell_h;

        /* F — per-row selection range (cells [sel_c0, sel_c1)).
         * -1 sentinel when row not in selection — flush_span treats
         * that as a no-overlap full-span paint. */
        int sel_c0 = -1, sel_c1 = -1;
        if (g_sel_active) {
            row_sel_range(r, sel_sr, sel_sc, sel_er, sel_ec, scr->cols,
                          &sel_c0, &sel_c1);
        }

        char span_text[4096];
        int  span_text_len = 0;
        int  span_start_col = 0;
        int  span_active = 0;
        Cell span_proto;
        memset(&span_proto, 0, sizeof span_proto);

        /* G — pull cells from the composite (scrollback + screen) view
         * via view_row_cells. NULL row → blank cells row. */
        const Cell *view_row = view_row_cells(g_term, r);
        Cell blank_cell = cell_empty();

        for (int c = 0; c < scr->cols; c++) {
            const Cell *cell = view_row ? &view_row[c] : &blank_cell;
            if (cell->wide_cont) continue;

            int boundary = (!span_active) || !cells_same_span(&span_proto, cell);
            if (boundary && span_active && span_text_len > 0) {
                /* Flush the in-flight span before starting a new one. */
                span_text[span_text_len] = '\0';
                if (flush_span(interp, canvas, r, span_start_col, c,
                               sel_c0, sel_c1,
                               y_pixel, span_text,
                               span_proto.fg, span_proto.bg, span_proto.attrs,
                               &x_pixel) != TCL_OK) return TCL_ERROR;
                span_text_len = 0;
            }
            if (boundary) {
                span_active = 1;
                span_proto = *cell;
                span_start_col = c;
            }

            uint32_t cp = cell->codepoint ? cell->codepoint : ' ';
            if (span_text_len + 4 < (int)sizeof span_text) {
                span_text_len += utf8_emit(cp, span_text + span_text_len,
                                           (int)sizeof span_text - span_text_len);
            }
        }

        if (span_active && span_text_len > 0) {
            span_text[span_text_len] = '\0';
            if (flush_span(interp, canvas, r, span_start_col, scr->cols,
                           sel_c0, sel_c1,
                           y_pixel, span_text,
                           span_proto.fg, span_proto.bg, span_proto.attrs,
                           &x_pixel) != TCL_OK) return TCL_ERROR;
        }
    }

    if (render_cursor(interp, canvas, scr) != TCL_OK) return TCL_ERROR;

    /* A2 — post-paint bbox-calibration may widen g_cell_w, then
     * compute_layout reflows the centered origin. Either change
     * triggers another paint so the next frame uses the corrected
     * geometry. Schedule (vs synchronous re-render) keeps render_screen
     * a single-pass call and prevents recursion. */
    int dirty = 0;
    if (bbox_calibrate(interp, scr)) dirty = 1;
    if (compute_layout(interp, scr)) dirty = 1;
    if (dirty) schedule_render();
    return TCL_OK;
}

/* ---- PTY plumbing (delegated to pty.phc) ---- */

/* pty.phc data callback. Drains as much as pty_read returns in one go,
 * pushes bytes through vt_parser, schedules a render. EOF tears down
 * the handler and signals the main loop to exit. The pty.phc layer
 * abstracts over POSIX (Tcl_CreateFileHandler on master fd) and Win32
 * (I/O thread + Tcl_AsyncMark) — same callback shape on both. */
static void on_pty_data(void *cd) {
    (void)cd;
    uint8_t buf[8192];
    pty_ssize_t n = pty_read(g_pty, buf, sizeof buf);
    if (n > 0) {
        vt_parser_feed(g_parser, buf, (int)n);
        /* C — keep the cursor solid while output streams; resume blink
         * 530ms after the last byte (legacy nbsterm.py:441-443). */
        blink_reset();
        /* G — auto-snap scroll-back view to live edge on any new
         * output (matches Apple Terminal / iTerm / xterm UX). */
        if (g_term) nbs_set_scroll_offset(g_term, 0);
        schedule_render();
        return;
    }
    if (n < 0) return;  /* EAGAIN / no data this wakeup */
    /* n == 0 = EOF: child died or PTY closed. */
    g_child_alive = 0;
    Tcl_SetVar2Ex(g_interp, "child_done", NULL, Tcl_NewIntObj(1),
                  TCL_GLOBAL_ONLY);
}

/* Idle render: collapses bursts of read() callbacks into one paint per
 * Tcl event-loop cycle. Without this, a 4 kB curses repaint can fire
 * render_screen 4-8 times for one logical frame. */
static void do_render_now(ClientData cd) {
    (void)cd;
    g_dirty = 0;
    if (!g_term) return;
    if (render_screen(g_interp, ".c", g_term) != TCL_OK) {
        fprintf(stderr, "render: %s\n", Tcl_GetStringResult(g_interp));
    }
}
static void schedule_render(void) {
    if (g_dirty) return;
    g_dirty = 1;
    Tcl_DoWhenIdle(do_render_now, NULL);
}

/* Tcl command: pty_write <bytes>. Bytes are the raw payload to push to
 * the child's stdin. Retained as a low-level escape hatch (e.g. pasted
 * bytes from PtyPaste); the live <Key> bind now routes through
 * pty_key_event for full input.phc coverage (D special-keys port,
 * theologian 15:47:17 + supervisor 15:46:07). */
static int PtyWrite(ClientData cd, Tcl_Interp *interp, int objc,
                    Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc != 2) {
        Tcl_WrongNumArgs(interp, 1, objv, "bytes");
        return TCL_ERROR;
    }
    int len = 0;
    const char *s = Tcl_GetStringFromObj(objv[1], &len);
    if (len <= 0) return TCL_OK;
    if (pty_write(g_pty, s, (size_t)len) < 0) {
        fprintf(stderr, "pty_write failed\n");
        return TCL_ERROR;
    }
    return TCL_OK;
}

/* Tcl command: pty_paste <text>. Pushes clipboard text into the
 * child, wrapping in bracketed-paste markers when the active screen
 * has DEC mode 2004 (mode_bracketed_paste) enabled. Mirrors
 * nbsterm.py:1379 _on_paste + extension.phc:179 Terminal_encode_paste
 * legacy. Bound via `bind .c <Control-Shift-V> {...}` on Linux/Win
 * and `bind .c <Command-v> {...}` on Mac per nbsterm.py:1170-1200. */
static int PtyPaste(ClientData cd, Tcl_Interp *interp, int objc,
                    Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc != 2) {
        Tcl_WrongNumArgs(interp, 1, objv, "text");
        return TCL_ERROR;
    }
    int len = 0;
    const char *s = Tcl_GetStringFromObj(objv[1], &len);
    if (len <= 0) return TCL_OK;
    int bracketed = (g_term && g_term->active &&
                     g_term->active->mode_bracketed_paste);
    if (bracketed && pty_write(g_pty, "\x1b[200~", 6) < 0) {
        fprintf(stderr, "pty_write paste-start failed\n");
        return TCL_ERROR;
    }
    if (pty_write(g_pty, s, (size_t)len) < 0) {
        fprintf(stderr, "pty_write paste-body failed\n");
        return TCL_ERROR;
    }
    if (bracketed && pty_write(g_pty, "\x1b[201~", 6) < 0) {
        fprintf(stderr, "pty_write paste-end failed\n");
        return TCL_ERROR;
    }
    return TCL_OK;
}

/* Tcl command: pty_resize <pixel_w> <pixel_h>. Bound via `bind .c
 * <Configure>`. Maps canvas pixels to a cell grid using g_cell_w /
 * g_cell_h (font.measure-derived at startup), propagates via
 * TIOCSWINSZ + terminal_resize, then forces a render. */
static int PtyResize(ClientData cd, Tcl_Interp *interp, int objc,
                     Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc != 3) {
        Tcl_WrongNumArgs(interp, 1, objv, "pixel_w pixel_h");
        return TCL_ERROR;
    }
    int pw = 0, ph = 0;
    if (Tcl_GetIntFromObj(interp, objv[1], &pw) != TCL_OK) return TCL_ERROR;
    if (Tcl_GetIntFromObj(interp, objv[2], &ph) != TCL_OK) return TCL_ERROR;
    int cols = pw / g_cell_w, rows = ph / g_cell_h;
    if (cols < 1) cols = 1;
    if (rows < 1) rows = 1;
    if (cols == g_term->active->cols && rows == g_term->active->rows) {
        /* Geometry-only resize (window dragged but cell grid unchanged):
         * still recompute layout because canvas_w/canvas_h shifted. */
        compute_layout(interp, g_term->active);
        schedule_render();
        return TCL_OK;
    }
    terminal_resize(g_term, rows, cols);
    pty_resize(g_pty, rows, cols);
    compute_layout(interp, g_term->active);
    schedule_render();
    return TCL_OK;
}

/* Tcl command: pty_key_event <keysym> <state> ?<char>? ?<alt>?. Bound
 * via `bind .c <Key> {pty_key_event %K %s %A 0}` for the base case
 * and `bind .c <Alt-Key> {pty_key_event %K %s %A 1; break}` for
 * Alt-modified keystrokes. Mirrors extension.phc:248-322
 * Terminal_encode_tk_event: special-key dispatch -> Return/BackSpace/
 * Tab/Escape -> Ctrl+letter -> Alt+key -> regular character via
 * encode_key_event. DECCKM via g_term->active->mode_app_cursor.
 * The <alt> arg is set by Tk's <Alt-Key> bind layer (which abstracts
 * the platform-specific Alt modifier — Mac Option vs X11/Win Alt —
 * inside Tk itself), so we no longer read a hardcoded mod-bit
 * (formerly 0x10 on aqua, 0x8 elsewhere) from %s. <char>/<alt>
 * optional because Tk's %A is empty for non-text keys (Up, F1, etc)
 * and the <Key> binding's command tokenises with a missing trailing
 * argument in that case. */
static int PtyKeyEvent(ClientData cd, Tcl_Interp *interp, int objc,
                       Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc < 3 || objc > 5) {
        Tcl_WrongNumArgs(interp, 1, objv, "keysym state ?char? ?alt?");
        return TCL_ERROR;
    }
    int keysym_len = 0, char_len = 0;
    const char *keysym = Tcl_GetStringFromObj(objv[1], &keysym_len);
    int state = 0;
    if (Tcl_GetIntFromObj(interp, objv[2], &state) != TCL_OK) return TCL_ERROR;
    const char *char_str = (objc >= 4)
                              ? Tcl_GetStringFromObj(objv[3], &char_len)
                              : "";
    int alt_pressed = 0;
    if (objc == 5 &&
        Tcl_GetIntFromObj(interp, objv[4], &alt_pressed) != TCL_OK) {
        return TCL_ERROR;
    }

    int char_code = 0;
    if (char_len > 0) {
        Tcl_UniChar uch = 0;
        Tcl_UtfToUniChar(char_str, &uch);
        char_code = (int)uch;
    }

    int modifiers = 0;
    if (state & 0x1) modifiers |= Modifier_Shift;
    if (alt_pressed) modifiers |= Modifier_Alt;
    if (state & 0x4) modifiers |= Modifier_Ctrl;

    int app_cursor = (g_term && g_term->active)
                       ? g_term->active->mode_app_cursor : 0;
    char buf[32];
    int  n = 0;

    /* Special keys — table verbatim from extension.phc:266-278. */
    static const struct { const char *name; int key; } special_map[] = {
        {"Up",     SpecialKey_Up},     {"Down",   SpecialKey_Down},
        {"Right",  SpecialKey_Right},  {"Left",   SpecialKey_Left},
        {"Home",   SpecialKey_Home},   {"End",    SpecialKey_End},
        {"Insert", SpecialKey_Insert}, {"Delete", SpecialKey_Delete},
        {"Prior",  SpecialKey_PageUp}, {"Next",   SpecialKey_PageDown},
        {"F1",  SpecialKey_F1},  {"F2",  SpecialKey_F2},
        {"F3",  SpecialKey_F3},  {"F4",  SpecialKey_F4},
        {"F5",  SpecialKey_F5},  {"F6",  SpecialKey_F6},
        {"F7",  SpecialKey_F7},  {"F8",  SpecialKey_F8},
        {"F9",  SpecialKey_F9},  {"F10", SpecialKey_F10},
        {"F11", SpecialKey_F11}, {"F12", SpecialKey_F12},
        {NULL, 0}
    };
    for (int i = 0; special_map[i].name; i++) {
        if (strcmp(keysym, special_map[i].name) == 0) {
            n = encode_special_key(special_map[i].key, modifiers, app_cursor,
                                   buf, (int)sizeof buf);
            if (n > 0) (void)pty_write(g_pty, buf, (size_t)n);
            return TCL_OK;
        }
    }

    /* Simple keys. */
    if (strcmp(keysym, "Return") == 0) {
        (void)pty_write(g_pty, "\r", 1);
        return TCL_OK;
    }
    if (strcmp(keysym, "BackSpace") == 0) {
        (void)pty_write(g_pty, "\x7f", 1);
        return TCL_OK;
    }
    if (strcmp(keysym, "Tab") == 0) {
        (void)pty_write(g_pty, "\t", 1);
        return TCL_OK;
    }
    if (strcmp(keysym, "Escape") == 0) {
        (void)pty_write(g_pty, "\x1b", 1);
        return TCL_OK;
    }

    /* Ctrl+letter — keysym is the unmodified letter ('a'..'z' / 'A'..'Z'),
     * Tk reports 'a' on Ctrl-A on Linux/Mac and the same on Win. */
    if ((state & 0x4) && keysym_len == 1 &&
        ((keysym[0] >= 'a' && keysym[0] <= 'z') ||
         (keysym[0] >= 'A' && keysym[0] <= 'Z'))) {
        char ctrl = (char)(keysym[0] & 0x1F);
        (void)pty_write(g_pty, &ctrl, 1);
        return TCL_OK;
    }

    /* Alt+key — ESC prefix + the keysym character. alt_pressed comes
     * from the explicit <alt> arg set by the Tk <Alt-Key> bind, not
     * from a hardcoded modifier-bit query on %s; Tk's bind layer
     * handles the platform-specific Alt modifier mapping (Mac Option
     * vs X11/Win Alt) so this code path is platform-agnostic. */
    if (alt_pressed && keysym_len == 1) {
        char ab[2] = {'\x1b', keysym[0]};
        (void)pty_write(g_pty, ab, 2);
        return TCL_OK;
    }

    /* Regular character via encode_key_event (handles Ctrl/Alt + char). */
    if (char_code >= 1) {
        n = encode_key_event(char_code, modifiers, app_cursor,
                             buf, (int)sizeof buf);
        if (n > 0) (void)pty_write(g_pty, buf, (size_t)n);
        return TCL_OK;
    }

    /* Unhandled key — silent no-op (matches Py_RETURN_NONE legacy). */
    return TCL_OK;
}

/* G — Tcl command nbs_scroll_lines <delta>. Positive delta scrolls
 * INTO history (toward older content); negative delta scrolls
 * toward live edge. No-op on alt-screen (vim/less) so wheel events
 * pass through to the app without disturbing its full-screen UI.
 * Mirrors extension.phc:1223-1237 Terminal_scroll_lines minus the
 * Python plumbing. */
static int NbsScrollLines(ClientData cd, Tcl_Interp *interp, int objc,
                          Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc != 2) {
        Tcl_WrongNumArgs(interp, 1, objv, "delta");
        return TCL_ERROR;
    }
    int delta = 0;
    if (Tcl_GetIntFromObj(interp, objv[1], &delta) != TCL_OK) return TCL_ERROR;
    if (!g_term || g_term->using_alt) return TCL_OK;
    nbs_scroll_lines_apply(g_term, delta);
    schedule_render();
    return TCL_OK;
}

/* F2 — copy current selection to the Tk clipboard. Walks selected
 * cells (sr,sc) to (er,ec) in canonical order; emits utf8 per cell
 * with '\n' on row boundary; writes via 'clipboard clear/append'.
 * Mirrors extension.phc:531-606 Terminal_extract_selected_text +
 * nbsterm.py:412-426 copy_selection. Bound to Cmd+C (Aqua) /
 * Ctrl+Shift+C (Win/X11). No-op when no selection. */
static int NbsCopy(ClientData cd, Tcl_Interp *interp, int objc,
                   Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc != 1) {
        Tcl_WrongNumArgs(interp, 1, objv, "");
        return TCL_ERROR;
    }
    if (!g_sel_active || !g_term || !g_term->active) return TCL_OK;

    int sr = g_sel_sr, sc = g_sel_sc;
    int er = g_sel_er, ec = g_sel_ec;
    sel_normalise(&sr, &sc, &er, &ec);

    const ScreenBuffer *scr = g_term->active;
    /* 64KB cap covers typical multi-screen selections; selection that
     * overflows just truncates rather than crashing. */
    static char buf[64 * 1024];
    int len = 0;

    for (int r = sr; r <= er && r < scr->rows; r++) {
        int c0 = -1, c1 = -1;
        row_sel_range(r, sr, sc, er, ec, scr->cols, &c0, &c1);
        if (c0 >= 0) {
            /* G — copy from the same composite view paint sees, so
             * selecting from scrollback content captures the visible
             * bytes rather than whatever the live screen now holds. */
            const Cell *view_row = view_row_cells(g_term, r);
            for (int c = c0; c < c1 && c < scr->cols; c++) {
                if (!view_row) {
                    if (len + 1 < (int)sizeof buf) buf[len++] = ' ';
                    continue;
                }
                const Cell *cell = &view_row[c];
                if (cell->wide_cont) continue;
                uint32_t cp = cell->codepoint ? cell->codepoint : ' ';
                if (len + 4 < (int)sizeof buf) {
                    len += utf8_emit(cp, buf + len, (int)sizeof buf - len);
                }
            }
        }
        /* Newline between rows (legacy nbsterm extracts row breaks
         * even when the selection extends past the row's last cell). */
        if (r < er && len + 1 < (int)sizeof buf) {
            buf[len++] = '\n';
        }
    }

    /* Clear + append via Tcl_EvalObjv (verify-no-eval-objex gate). */
    {
        const char *clear[] = {"clipboard", "clear", "-displayof", "."};
        if (EVAL_ARGV(interp, clear) != TCL_OK) return TCL_ERROR;
    }
    Tcl_Obj *argv[6];
    argv[0] = Tcl_NewStringObj("clipboard", -1);
    argv[1] = Tcl_NewStringObj("append",    -1);
    argv[2] = Tcl_NewStringObj("-displayof", -1);
    argv[3] = Tcl_NewStringObj(".", -1);
    argv[4] = Tcl_NewStringObj("--", -1);
    argv[5] = Tcl_NewStringObj(buf, len);
    for (int i = 0; i < 6; i++) Tcl_IncrRefCount(argv[i]);
    int rc = Tcl_EvalObjv(interp, 6, argv, 0);
    for (int i = 0; i < 6; i++) Tcl_DecrRefCount(argv[i]);
    return rc;
}

/* F — mouse selection start/extend/end. NbsSelDown captures the
 * anchor cell + activates selection; NbsSelDrag/Up extends the end
 * cell. Tk binds wire ButtonPress-1 / B1-Motion / ButtonRelease-1
 * to these. Mirrors nbsterm.py:339-354 _on_mouse_* legacy. */
static int NbsSelDown(ClientData cd, Tcl_Interp *interp, int objc,
                      Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc != 3) {
        Tcl_WrongNumArgs(interp, 1, objv, "x y");
        return TCL_ERROR;
    }
    int px = 0, py = 0;
    if (Tcl_GetIntFromObj(interp, objv[1], &px) != TCL_OK) return TCL_ERROR;
    if (Tcl_GetIntFromObj(interp, objv[2], &py) != TCL_OK) return TCL_ERROR;
    int r = 0, c = 0;
    pixel_to_cell_text_aware(interp, px, py, &r, &c);
    g_sel_sr = g_sel_er = r;
    g_sel_sc = g_sel_ec = c;
    g_sel_active = 1;
    schedule_render();
    return TCL_OK;
}

static int NbsSelDrag(ClientData cd, Tcl_Interp *interp, int objc,
                      Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc != 3) {
        Tcl_WrongNumArgs(interp, 1, objv, "x y");
        return TCL_ERROR;
    }
    if (!g_sel_active) return TCL_OK;
    int px = 0, py = 0;
    if (Tcl_GetIntFromObj(interp, objv[1], &px) != TCL_OK) return TCL_ERROR;
    if (Tcl_GetIntFromObj(interp, objv[2], &py) != TCL_OK) return TCL_ERROR;
    int r = 0, c = 0;
    pixel_to_cell_text_aware(interp, px, py, &r, &c);
    g_sel_er = r;
    g_sel_ec = c;
    schedule_render();
    return TCL_OK;
}

static int NbsSelUp(ClientData cd, Tcl_Interp *interp, int objc,
                    Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc != 3) {
        Tcl_WrongNumArgs(interp, 1, objv, "x y");
        return TCL_ERROR;
    }
    if (!g_sel_active) return TCL_OK;
    int px = 0, py = 0;
    if (Tcl_GetIntFromObj(interp, objv[1], &px) != TCL_OK) return TCL_ERROR;
    if (Tcl_GetIntFromObj(interp, objv[2], &py) != TCL_OK) return TCL_ERROR;
    int r = 0, c = 0;
    pixel_to_cell_text_aware(interp, px, py, &r, &c);
    g_sel_er = r;
    g_sel_ec = c;
    /* If user clicked without dragging — start cell == end cell —
     * collapse selection (matches nbsterm.py click-to-clear UX). */
    if (g_sel_sr == g_sel_er && g_sel_sc == g_sel_ec) {
        g_sel_active = 0;
    }
    schedule_render();
    return TCL_OK;
}

/* A3 — apply a freshly-loaded g_config to the live binary. Mirrors
 * nbsterm.py:1398-1429 _apply_config: re-configure named fonts,
 * recompute cell metrics, re-paint canvas -bg with gamma, recompute
 * rows/cols from canvas pixels, screen+pty resize if the cell grid
 * shifts, blink_reset, schedule_render. Called from PrefsSave +
 * (future) honest-file watcher. */
static void nbs_apply_config(Tcl_Interp *interp) {
    /* Resolve g_config.font.family via [font actual] before passing
     * to font configure — same alias-resolution as register_named_
     * fonts (theologian 2026-05-13 15:36:51). Without this, saving
     * Prefs with TkFixedFont (or any other Tk alias) reconfigures
     * font_bold/italic to lose -weight/-slant variants again. */
    char fam[128];
    snprintf(fam, sizeof fam, "%s", g_config.font.family);
    char resolve_cmd[256];
    snprintf(resolve_cmd, sizeof resolve_cmd,
             "font actual {%s} -family", fam);
    if (Tcl_Eval(interp, resolve_cmd) == TCL_OK) {
        const char *r = Tcl_GetStringResult(interp);
        if (r && *r) snprintf(fam, sizeof fam, "%s", r);
    }
    /* Reconfigure the four named fonts to the new family/size. */
    char fontcmd[1024];
    snprintf(fontcmd, sizeof fontcmd,
        "font configure font_normal       -family {%s} -size %d;"
        "font configure font_bold         -family {%s} -size %d -weight bold;"
        "font configure font_italic       -family {%s} -size %d -slant italic;"
        "font configure font_bold_italic  -family {%s} -size %d -weight bold -slant italic",
        fam, g_config.font.size,
        fam, g_config.font.size,
        fam, g_config.font.size,
        fam, g_config.font.size);
    Tcl_Eval(interp, fontcmd);

    compute_cell_metrics(interp);

    /* Repaint canvas widget bg with gamma transform — mirrors the
     * 17fe5dc uniform-gamma path at canvas creation. */
    char canvas_bg_g[16];
    const char *canvas_bg = gamma_apply(g_config.bg, canvas_bg_g, sizeof canvas_bg_g);
    char bgcmd[64];
    snprintf(bgcmd, sizeof bgcmd, ".c configure -bg %s", canvas_bg);
    Tcl_Eval(interp, bgcmd);

    /* Reflow on the new cell grid: derive rows/cols from canvas px. */
    int canvas_w = 0, canvas_h = 0;
    if (Tcl_Eval(interp, "winfo width .c") == TCL_OK) {
        canvas_w = atoi(Tcl_GetStringResult(interp));
    }
    if (Tcl_Eval(interp, "winfo height .c") == TCL_OK) {
        canvas_h = atoi(Tcl_GetStringResult(interp));
    }
    int new_cols = canvas_w / g_cell_w;
    int new_rows = canvas_h / g_cell_h;
    if (new_cols < 1) new_cols = g_config.cols;
    if (new_rows < 1) new_rows = g_config.rows;
    if (g_term && g_term->active &&
        (new_rows != g_term->active->rows || new_cols != g_term->active->cols)) {
        terminal_resize(g_term, new_rows, new_cols);
        if (g_pty) pty_resize(g_pty, new_rows, new_cols);
    }

    /* Re-arm blink (config.cursor.blink may have flipped). */
    blink_reset();

    compute_layout(interp, g_term ? g_term->active : NULL);
    schedule_render();
}

/* Tcl command: nbs_save_prefs <font_family> <font_size> <cursor_style>
 *   <cursor_blink> <cursor_color> <gamma> <fg> <bg> <rows> <cols>
 *   <refresh_hz>. Reads 11 fields from the dialog Tcl vars, validates,
 *   writes to g_config, persists via nbs_config_save, applies live
 *   via nbs_apply_config, destroys the dialog. */
static int NbsSavePrefs(ClientData cd, Tcl_Interp *interp, int objc,
                        Tcl_Obj *const objv[]) {
    (void)cd;
    if (objc != 12) {
        Tcl_WrongNumArgs(interp, 1, objv,
            "font_family font_size cursor_style cursor_blink cursor_color "
            "gamma fg bg rows cols refresh_hz");
        return TCL_ERROR;
    }
    int    font_size = 14, cursor_blink = 1, rows = 24, cols = 80, refresh_hz = 60;
    double gamma = 1.0;
    if (Tcl_GetIntFromObj(interp, objv[2], &font_size)    != TCL_OK) return TCL_ERROR;
    if (Tcl_GetIntFromObj(interp, objv[4], &cursor_blink) != TCL_OK) return TCL_ERROR;
    if (Tcl_GetDoubleFromObj(interp, objv[6], &gamma)      != TCL_OK) return TCL_ERROR;
    if (Tcl_GetIntFromObj(interp, objv[9],  &rows)        != TCL_OK) return TCL_ERROR;
    if (Tcl_GetIntFromObj(interp, objv[10], &cols)        != TCL_OK) return TCL_ERROR;
    if (Tcl_GetIntFromObj(interp, objv[11], &refresh_hz)  != TCL_OK) return TCL_ERROR;

    snprintf(g_config.font.family, sizeof g_config.font.family, "%s",
             Tcl_GetString(objv[1]));
    if (font_size > 0  && font_size <= 200)  g_config.font.size  = font_size;
    snprintf(g_config.cursor.style, sizeof g_config.cursor.style, "%s",
             Tcl_GetString(objv[3]));
    g_config.cursor.blink = cursor_blink ? 1 : 0;
    snprintf(g_config.cursor.color, sizeof g_config.cursor.color, "%s",
             Tcl_GetString(objv[5]));
    if (gamma > 0.0    && gamma <= 5.0)      g_config.gamma      = gamma;
    snprintf(g_config.fg, sizeof g_config.fg, "%s", Tcl_GetString(objv[7]));
    snprintf(g_config.bg, sizeof g_config.bg, "%s", Tcl_GetString(objv[8]));
    if (rows > 0       && rows <= 9999)      g_config.rows       = rows;
    if (cols > 0       && cols <= 9999)      g_config.cols       = cols;
    if (refresh_hz > 0 && refresh_hz <= 240) g_config.refresh_hz = refresh_hz;

    if (!nbs_config_save(&g_config)) {
        fprintf(stderr, "nbs-term: could not save config (continuing in-memory)\n");
    }
    nbs_apply_config(interp);
    Tcl_Eval(interp, "destroy .prefs");
    return TCL_OK;
}

/* Tcl command: nbs_open_prefs. Builds the PreferencesDialog Toplevel
 * (legacy nbsterm.py:887-1051 shape, smaller widget set — Save +
 * Cancel + 11 fields). Color picks via tk_chooseColor (built-in
 * 24-bit picker; ColorPicker256 lift deferred to A3b). */
static int NbsOpenPrefs(ClientData cd, Tcl_Interp *interp, int objc,
                        Tcl_Obj *const objv[]) {
    (void)cd; (void)objc; (void)objv;
    char dlg[8192];
    snprintf(dlg, sizeof dlg,
        "if {[winfo exists .prefs]} {raise .prefs; return};"
        "toplevel .prefs;"
        "wm title .prefs {nbs-term Preferences};"
        "wm transient .prefs .;"
        "set ::prefs_font_family   {%s};"
        "set ::prefs_font_size     %d;"
        "set ::prefs_cursor_style  {%s};"
        "set ::prefs_cursor_blink  %d;"
        "set ::prefs_cursor_color  {%s};"
        "set ::prefs_gamma         %.2f;"
        "set ::prefs_fg            {%s};"
        "set ::prefs_bg            {%s};"
        "set ::prefs_rows          %d;"
        "set ::prefs_cols          %d;"
        "set ::prefs_refresh_hz    %d;"

        /* A3a font picker: monospace-filtered ttk::combobox per alexie
         * 2026-05-13 11:17:33 ('humans cannot remember font names').
         * Probe each family's [list family 12] spec — fixed-width if
         * font measure 'M' == measure 'i'. State left editable so power
         * users can still type a custom family not in the system list. */
        "set row 0;"
        "set ::prefs_font_families {TkFixedFont};"
        "foreach __fam [lsort -unique [font families]] {"
        "  if {[font measure [list $__fam 12] M] == [font measure [list $__fam 12] i]} {"
        "    lappend ::prefs_font_families $__fam;"
        "  };"
        "};"
        "unset -nocomplain __fam;"
        "label .prefs.lf  -text {Font family:};  grid .prefs.lf  -row $row -column 0 -sticky e;"
        "ttk::combobox .prefs.ef -values $::prefs_font_families "
        "  -textvariable ::prefs_font_family -width 24;"
        "  grid .prefs.ef -row $row -column 1 -sticky w; incr row;"
        "label .prefs.ls  -text {Font size:};    grid .prefs.ls -row $row -column 0 -sticky e;"
        "spinbox .prefs.es -from 6 -to 72 -textvariable ::prefs_font_size -width 6;"
        "  grid .prefs.es -row $row -column 1 -sticky w; incr row;"

        "label .prefs.lcs -text {Cursor style:}; grid .prefs.lcs -row $row -column 0 -sticky e;"
        "ttk::combobox .prefs.ecs -values {Block Underline Bar} "
        "  -textvariable ::prefs_cursor_style -state readonly -width 10;"
        "  grid .prefs.ecs -row $row -column 1 -sticky w; incr row;"
        "label .prefs.lcb -text {Cursor blink:}; grid .prefs.lcb -row $row -column 0 -sticky e;"
        "checkbutton .prefs.ecb -variable ::prefs_cursor_blink;"
        "  grid .prefs.ecb -row $row -column 1 -sticky w; incr row;"
        "label .prefs.lcc -text {Cursor color:}; grid .prefs.lcc -row $row -column 0 -sticky e;"
        "frame .prefs.fcc;"
        "  entry .prefs.fcc.e -textvariable ::prefs_cursor_color -width 10;"
        "  button .prefs.fcc.b -text {Pick} -command "
        "    {set c [tk_chooseColor -initialcolor $::prefs_cursor_color -parent .prefs];"
        "     if {$c ne {}} {set ::prefs_cursor_color $c}};"
        "  pack .prefs.fcc.e .prefs.fcc.b -side left;"
        "  grid .prefs.fcc -row $row -column 1 -sticky w; incr row;"

        "label .prefs.lfg -text {Foreground:};   grid .prefs.lfg -row $row -column 0 -sticky e;"
        "frame .prefs.ffg;"
        "  entry .prefs.ffg.e -textvariable ::prefs_fg -width 10;"
        "  button .prefs.ffg.b -text {Pick} -command "
        "    {set c [tk_chooseColor -initialcolor $::prefs_fg -parent .prefs];"
        "     if {$c ne {}} {set ::prefs_fg $c}};"
        "  pack .prefs.ffg.e .prefs.ffg.b -side left;"
        "  grid .prefs.ffg -row $row -column 1 -sticky w; incr row;"
        "label .prefs.lbg -text {Background:};   grid .prefs.lbg -row $row -column 0 -sticky e;"
        "frame .prefs.fbg;"
        "  entry .prefs.fbg.e -textvariable ::prefs_bg -width 10;"
        "  button .prefs.fbg.b -text {Pick} -command "
        "    {set c [tk_chooseColor -initialcolor $::prefs_bg -parent .prefs];"
        "     if {$c ne {}} {set ::prefs_bg $c}};"
        "  pack .prefs.fbg.e .prefs.fbg.b -side left;"
        "  grid .prefs.fbg -row $row -column 1 -sticky w; incr row;"
        "label .prefs.lg  -text {Gamma:};        grid .prefs.lg -row $row -column 0 -sticky e;"
        "scale .prefs.eg -from 0.5 -to 2.0 -resolution 0.05 -orient horizontal "
        "  -variable ::prefs_gamma -length 200;"
        "  grid .prefs.eg -row $row -column 1 -sticky w; incr row;"

        "label .prefs.lr  -text {Rows:};         grid .prefs.lr -row $row -column 0 -sticky e;"
        "spinbox .prefs.er -from 1 -to 999 -textvariable ::prefs_rows -width 6;"
        "  grid .prefs.er -row $row -column 1 -sticky w; incr row;"
        "label .prefs.lc  -text {Cols:};         grid .prefs.lc -row $row -column 0 -sticky e;"
        "spinbox .prefs.ec -from 1 -to 999 -textvariable ::prefs_cols -width 6;"
        "  grid .prefs.ec -row $row -column 1 -sticky w; incr row;"
        "label .prefs.lh  -text {Refresh Hz:};   grid .prefs.lh -row $row -column 0 -sticky e;"
        "scale .prefs.eh -from 10 -to 120 -orient horizontal "
        "  -variable ::prefs_refresh_hz -length 200;"
        "  grid .prefs.eh -row $row -column 1 -sticky w; incr row;"

        "frame .prefs.btn;"
        "  button .prefs.btn.s -text Save    -command "
        "    {nbs_save_prefs $::prefs_font_family $::prefs_font_size "
        "     $::prefs_cursor_style $::prefs_cursor_blink $::prefs_cursor_color "
        "     $::prefs_gamma $::prefs_fg $::prefs_bg "
        "     $::prefs_rows $::prefs_cols $::prefs_refresh_hz};"
        "  button .prefs.btn.c -text Cancel  -command {destroy .prefs};"
        "  pack .prefs.btn.s .prefs.btn.c -side left -padx 4;"
        "  grid .prefs.btn -row $row -column 0 -columnspan 2 -pady 8",

        g_config.font.family, g_config.font.size,
        g_config.cursor.style, g_config.cursor.blink, g_config.cursor.color,
        g_config.gamma,
        g_config.fg, g_config.bg,
        g_config.rows, g_config.cols, g_config.refresh_hz);
    if (Tcl_Eval(interp, dlg) != TCL_OK) {
        fprintf(stderr, "nbs-term: failed to open Preferences: %s\n",
                Tcl_GetStringResult(interp));
        return TCL_ERROR;
    }
    return TCL_OK;
}

/* Build the argv vector for the child. If --ssh is the first user arg,
 * the rest of argv becomes the child argv; otherwise spawn $SHELL (or
 * /bin/sh on POSIX, cmd.exe on Win32) as a login shell calibration. */
static char **build_child_argv(int argc, char *argv[]) {
    int i = 1;
    while (i < argc && strcmp(argv[i], "-test") == 0) i++;  /* skip self-test flag */
    if (i < argc && strcmp(argv[i], "--ssh") == 0) {
        i++;
        if (i >= argc) {
            fprintf(stderr, "--ssh requires program argv\n");
            return NULL;
        }
        char **out = (char **)calloc((size_t)(argc - i + 1), sizeof(char *));
        for (int j = 0; j + i < argc; j++) out[j] = argv[i + j];
        return out;
    }
    const char *shell = getenv("SHELL");
    if (!shell || !*shell) {
#if defined(_WIN32)
        shell = "cmd.exe";
#else
        shell = "/bin/sh";
#endif
    }
    char **out = (char **)calloc(2, sizeof(char *));
    out[0] = (char *)shell;
    out[1] = NULL;
    return out;
}

/* NBS_TEST_MODE: when defined, suppress this file's main() so a test
 * binary (tests/test_render_state.phc) can #include p3_pty.phc and
 * provide its own main() while reusing all the file-scope statics
 * (render_screen / flush_span / render_cursor / pixel_to_cell / etc).
 * Per theologian state-dump-shim harness design (chat 09:52:42 +
 * supervisor 09:53:13 GO). Production p3_pty build does NOT define
 * NBS_TEST_MODE; behaviour is unchanged for the live binary. */
#ifndef NBS_TEST_MODE
int main(int argc, char *argv[]) {
    Tcl_FindExecutable(argv[0]);

    /* Load config first so terminal/canvas init use file/default values
     * instead of compile-time constants. nbs_config_load is total — it
     * always populates g_config (file values where present, defaults
     * elsewhere). */
    nbs_config_load(&g_config);

    g_interp = Tcl_CreateInterp();
    if (Tcl_Init(g_interp) != TCL_OK ||
        Tcl_Eval(g_interp, "package require Tk") != TCL_OK) {
        fprintf(stderr, "init: %s\n", Tcl_GetStringResult(g_interp));
        return 1;
    }
    /* Register the legacy named fonts before any metrics query — the
     * span renderer + cursor measure both reference 'font_normal'.
     * compute_cell_metrics queries font_normal for the cell grid. */
    register_named_fonts(g_interp);
    compute_cell_metrics(g_interp);

    g_term = terminal_new(g_config.rows, g_config.cols);
    if (!g_term) { fprintf(stderr, "terminal_new failed\n"); return 1; }
    g_parser = vt_parser_new(g_term);
    if (!g_parser) { fprintf(stderr, "vt_parser_new failed\n"); return 1; }

    char **child_argv = build_child_argv(argc, argv);
    if (!child_argv) return 1;
    g_pty = pty_open(child_argv, g_config.rows, g_config.cols);
    if (!g_pty) return 1;

    Tcl_CreateObjCommand(g_interp, "pty_write",      PtyWrite,    NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "pty_resize",     PtyResize,   NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "pty_paste",      PtyPaste,    NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "pty_key_event",  PtyKeyEvent, NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "nbs_open_prefs", NbsOpenPrefs, NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "nbs_save_prefs", NbsSavePrefs, NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "nbs_sel_down",   NbsSelDown,   NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "nbs_sel_drag",   NbsSelDrag,   NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "nbs_sel_up",     NbsSelUp,     NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "nbs_copy",       NbsCopy,      NULL, NULL);
    Tcl_CreateObjCommand(g_interp, "nbs_scroll_lines", NbsScrollLines, NULL, NULL);

    pty_install_tcl_handler(g_pty, g_interp, on_pty_data, NULL);

    /* C — kick off the blink timer if config enables it. blink_proc
     * reschedules itself; on_pty_data resets via blink_reset(). */
    if (g_config.cursor.blink) {
        g_blink_after_id = Tcl_CreateTimerHandler(NBS_BLINK_MS, blink_proc, NULL);
    }

    char wstr[16], hstr[16];
    snprintf(wstr, sizeof wstr, "%d", g_config.cols * g_cell_w);
    snprintf(hstr, sizeof hstr, "%d", g_config.rows * g_cell_h);
    /* Canvas widget -bg gets gamma-corrected to match per-cell bg
     * paint downstream (flush_span runs gamma on every cell rect).
     * 59ed176 Bug C v3: when canvas widget -bg is RAW and per-cell bg
     * is GAMMAED, Mac (gamma=1.2) shows cells visibly darker than
     * the canvas slop. Uniform application here closes that path. */
    char canvas_bg_g[16];
    const char *canvas_bg = gamma_apply(g_config.bg, canvas_bg_g,
                                         sizeof canvas_bg_g);
    /* -borderwidth 0 mirrors legacy nbsterm.py:160 (was missing in
     * pure-phc port). On Mac aqua the default canvas borderwidth
     * draws a tinted frame OUTSIDE the canvas-item drawing area;
     * bg_fill rect (which paints inside the drawing area) cannot
     * cover it, leaving a visible margin asymmetry on wide windows.
     * Combined with -highlightthickness 0 these zero out both
     * widget chrome layers (alexie 2026-05-13 14:51:46 wide-window
     * symptom + librarian 14:50:35 + supervisor 14:51:44 routing). */
    const char *canvas[] = {"canvas", ".c",
                            "-width", wstr, "-height", hstr,
                            "-bg", canvas_bg,
                            "-borderwidth", "0",
                            "-highlightthickness", "0"};
    /* Paste binding: Cmd-V on Aqua, Ctrl-Shift-V on Win/X11 — mirrors
     * nbsterm.py:1170-1200 legacy. Wrapping `clipboard get` in catch
     * makes empty/unset clipboard a no-op rather than a Tcl error.
     * Trailing 'break' stops Tk from also routing the keystroke to the
     * <Key> handler (which would type a literal 'V'). */
    if (EVAL_ARGV(g_interp, canvas) != TCL_OK ||
        Tcl_Eval(g_interp,
            "pack .c -fill both -expand 1;"
            "focus .c;"
            /* Base <Key> bind passes alt=0; Tk's more-specific
             * <Alt-Key> match wins for Alt-modified keystrokes (next
             * line) and passes alt=1 + ; break to consume the chain.
             * Tk abstracts the platform Alt-modifier mapping (Mac
             * Option / X11+Win Alt) inside the bind layer, so the C
             * dispatcher no longer reads a hardcoded mod-bit; removes
             * the [tk windowingsystem]-driven g_is_mac runtime branch
             * that previously selected 0x10 vs 0x8 on %s (alexie
             * 2026-05-13 15:50:38 'avoid machine-specifics'). */
            "bind .c <Key>     {pty_key_event %K %s %A 0};"
            "bind .c <Alt-Key> {pty_key_event %K %s %A 1; break};"
            "bind .c <Configure> {pty_resize %w %h};"
            "bind .c <ButtonPress-1>   {nbs_sel_down %x %y};"
            "bind .c <B1-Motion>       {nbs_sel_drag %x %y};"
            "bind .c <ButtonRelease-1> {nbs_sel_up   %x %y};"
            /* G — wheel + keyboard scroll bindings. MouseWheel %D
             * convention: positive = wheel up = scroll into history.
             * Linux uses Button-4 (up) / Button-5 (down). Trailing
             * 'break' on every bind is load-bearing per Bug B1
             * (5525918 D-1776953112 nbsterm.py:298/304) — without
             * it Ctrl-Shift-Up also fires the <Key> bind and
             * leaks ESC[A to the PTY. */
            "bind . <MouseWheel> "
            "  {nbs_scroll_lines [expr {%D > 0 ? 3 : -3}]; break};"
            "bind . <Button-4>   {nbs_scroll_lines  3; break};"
            "bind . <Button-5>   {nbs_scroll_lines -3; break};"
            /* Keyboard scrolls live on .c so the more-specific
             * <Control-Shift-Up> match wins over .c's general <Key>
             * binding (which would otherwise fire encode_special_key
             * for Up and leak ESC[A to the PTY). Wheel binds stay on
             * '.' since wheel events have no competing <Key>. */
            "bind .c <Control-Shift-Up>   {nbs_scroll_lines  1; break};"
            "bind .c <Control-Shift-Down> {nbs_scroll_lines -1; break};"
            /* Dual-bind both Cmd-X (Mac) AND Ctrl-Shift-X / Ctrl-X
             * (non-Mac) accelerators unconditionally per supervisor
             * 2026-05-13 15:53:44 + theologian 15:53:38. Removes the
             * `tk windowingsystem eq aqua` runtime branch on this
             * surface. <Command-X> is Mac-only in Tk (alias for
             * Cmd modifier on aqua; not aliased to Ctrl on X11/Win
             * — would-be misalias would steal terminal Ctrl-C SIGINT
             * etc); inert no-op on non-Mac platforms. <Control-Shift-X>
             * + <Control-comma> are user-meaningful on Win/Linux and
             * also work on Mac as a power-user fallback. UX preserved
             * (Mac Cmd-X / Win-Linux Ctrl-X both work as expected);
             * machine-specifics removed per alexie 15:50:38 'avoid
             * machine specifics'. */
            "bind .c <Command-v> "
            "  {if {![catch {clipboard get} t]} {pty_paste $t}; break};"
            "bind .c <Control-Shift-V> "
            "  {if {![catch {clipboard get} t]} {pty_paste $t}; break};"
            "bind .c <Command-comma>    {nbs_open_prefs; break};"
            "bind .c <Control-comma>    {nbs_open_prefs; break};"
            "bind .c <Command-c>        {nbs_copy; break};"
            "bind .c <Control-Shift-C>  {nbs_copy; break};"
            "wm protocol . WM_DELETE_WINDOW {set child_done 1}"
        ) != TCL_OK) {
        fprintf(stderr, "ui: %s\n", Tcl_GetStringResult(g_interp));
        return 1;
    }
    schedule_render();

    /* Self-test: drain a few read cycles, prove the file handler fires
     * on a known prompt-producing command, then break. */
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "-test") == 0) {
            const char *probe = "echo phc_p3_round_trip_ok\n";
            (void)pty_write(g_pty, probe, strlen(probe));
            /* Pump events until either child writes or 2s timeout. */
            for (int loops = 0; loops < 200 && g_child_alive; loops++) {
                Tcl_DoOneEvent(TCL_DONT_WAIT | TCL_FILE_EVENTS | TCL_IDLE_EVENTS);
                /* Look for the marker across all spans on each row.
                 * row{r} tag aggregates every span on the row (one
                 * text item per span, multiple per row possible after
                 * A1 span-split port); concat their -text and search. */
                Tcl_Eval(g_interp,
                    "set found 0;"
                    "for {set r 0} {$r < 24} {incr r} {"
                    "  set ids [.c find withtag row$r];"
                    "  if {[llength $ids] == 0} continue;"
                    "  set joined \"\";"
                    "  foreach id $ids { append joined [.c itemcget $id -text] };"
                    "  if {[string first phc_p3_round_trip_ok $joined] >= 0} {"
                    "    set found 1; break"
                    "  }"
                    "};"
                    "set found");
                if (atoi(Tcl_GetStringResult(g_interp)) > 0) {
                    fprintf(stderr, "self-test ok: PTY echo -> render round-trip\n");
                    pty_kill(g_pty);
                    pty_free(g_pty);
                    free(child_argv);
                    terminal_free(g_term);
                    return 0;
                }
#if defined(_WIN32)
                Sleep(10);
#else
                struct timespec ts = {0, 10 * 1000 * 1000};  /* 10ms */
                nanosleep(&ts, NULL);
#endif
            }
            fprintf(stderr, "self-test failed: marker not seen\n");
            pty_kill(g_pty);
            pty_free(g_pty);
            return 2;
        }
    }

    /* Normal interactive run. vwait dispatches both fd events and idle
     * renders until child_done is set (PTY EOF or window close). */
    Tcl_Eval(g_interp, "vwait child_done");
    pty_kill(g_pty);
    pty_free(g_pty);
    free(child_argv);
    terminal_free(g_term);
    return 0;
}
#endif  /* !NBS_TEST_MODE */
